    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@material/material-color-utilities": "0.4.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "centrifuge": "^5.7.4",
    "lean-qr": "^2.7.4",
    "marked": "^18.1.1",
    "material-symbols": "^0.48.0",
    "rxjs": "~7.8.0",
