    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.13.0",
    "harfbuzzjs": "^1.6.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
