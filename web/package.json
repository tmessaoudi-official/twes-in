{
  "name": "twes-in-web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "twes-in admin web app (Angular)",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "icons": "node scripts/subset-icons.mjs",
    "prebuild": "npm run icons",
    "prestart": "npm run icons",
    "pretest": "npm run icons",
    "test": "ng test",
    "lint": "ng lint",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "gate": "npm run api:types && npm run lint && npm run typecheck:e2e && npm run format:check && npm test && npm run build",
    "api:types": "openapi-ts"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
