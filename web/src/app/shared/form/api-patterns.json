{
  "#^(https://[^\\s/?\\#]+\\.[^\\s/?\\#]+(/\\S*)?)?$#": {
    "delimited": true,
    "valid": ["", "https://status.exemple.tn", "https://status.example.com/page"],
    "invalid": ["http://status.exemple.tn", "https://status", "status.exemple.tn"]
  },
  "/^((?=(?:[^0-9]*[0-9]){6,15}[^0-9]*$)\\+?[0-9    -   　().\\-]+)?$/u": {
    "delimited": true,
    "valid": ["", "+216 71 000 000", "+216 71 000 000", "71000000"],
    "invalid": ["12345", "abc"]
  },
  "/^([A-Za-z0-9][A-Za-z0-9._\\/-]*)?\\{SEQ(:([1-9]|1[0-2]))?\\}[A-Za-z0-9._\\/-]*$/": {
    "delimited": true,
    "valid": ["{SEQ}", "ART-{SEQ:5}", "P{SEQ}-A"],
    "invalid": ["ART-", "ART-{SEQ:13}", "-{SEQ}"]
  },
  "/^([a-zA-Z0-9.!#$%&'*+\\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+)?$/D": {
    "delimited": true,
    "valid": ["", "support@exemple.tn", "a.b+c@sub.example.com"],
    "invalid": ["support@exemple", "support exemple.tn", "support@"]
  },
  "/^(\\+[1-9][0-9    -   　]{7,20})?$/u": {
    "delimited": true,
    "valid": ["", "+216 20 123 456", "+216 20 123 456"],
    "invalid": ["20123456", "+0 20 123 456"]
  },
  "/^[A-Z0-9]{2,3}$/": {
    "delimited": true,
    "valid": ["C62", "KGM", "H87"],
    "invalid": ["c62", "C", "C6200"]
  },
  "/^\\s*([0-9]{1,9}([.,][0-9]{1,3})?\\s*%?)?(\\s*;\\s*([0-9]{1,9}([.,][0-9]{1,3})?\\s*%?)?){0,4}\\s*$/u": {
    "delimited": true,
    "valid": ["", "5", "5 ; 2 %", "5,5; 2.5%"],
    "invalid": ["abc", "5;;;;;;2"]
  },
  "/^\\s*\\d{1,3}(\\s*,\\s*\\d{1,3}){0,4}\\s*$/": {
