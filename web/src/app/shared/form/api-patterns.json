    "valid": ["7, 15, 30", "30"],
    "invalid": ["7;15", "1000", "x"]
  },
  "^(?:FR[0-9A-Z]{2}[0-9]{9}|ATU[0-9]{8}|BE[01][0-9]{9}|BG[0-9]{9,10}|CY[0-9]{8}[A-Z]|CZ[0-9]{8,10}|DE[0-9]{9}|DK[0-9]{8}|EE[0-9]{9}|EL[0-9]{9}|ES(?:[0-9A-Z][0-9]{7}[A-Z]|[A-Z][0-9]{7}[0-9])|FI[0-9]{8}|HR[0-9]{11}|HU[0-9]{8}|IE(?:[0-9][0-9A-Z+*][0-9]{5}[A-Z]|[0-9]{7}[A-Z]{2})|IT[0-9]{11}|LT(?:[0-9]{9}|[0-9]{12})|LU[0-9]{8}|LV[0-9]{11}|MT[0-9]{8}|NL[0-9A-Z+*]{12}|PL[0-9]{10}|PT[0-9]{9}|RO[0-9]{2,10}|SE[0-9]{12}|SI[0-9]{8}|SK[0-9]{10}|XI(?:[0-9]{9}|[0-9]{12}|GD[0-9]{3}|HA[0-9]{3}))$": {
