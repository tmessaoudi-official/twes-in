{
  "name": "twes-in/api",
  "description": "twes-in invoicing API (Symfony + API Platform)",
  "license": "AGPL-3.0-or-later",
  "type": "project",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "api-platform/core": "^4.3.19",
    "doctrine/doctrine-bundle": "^3.3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.7",
    "spomky-labs/otphp": "^11.5",
    "symfony/config": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/expression-language": "8.1.*",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/intl": "8.1.*",
    "symfony/mailer": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/rate-limiter": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/uid": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "phpstan/extension-installer": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "lint": "php-cs-fixer check --diff",
    "lint:fix": "php-cs-fixer fix",
    "stan": [
      "bin/console cache:warmup --env=test --no-interaction",
      "phpstan analyse --memory-limit=1G --no-progress"
    ],
    "test": [
      "bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --env=test",
      "phpunit"
    ],
    "gate": [
      "@lint",
      "@stan",
      "@test"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": "true",
      "require": "8.1.*"
    }
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "*",
    "friendsofphp/php-cs-fixer": "*",
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": ">=2.2.14",
    "phpstan/phpstan-doctrine": "*",
    "phpstan/phpstan-symfony": "*",
    "phpunit/phpunit": "^13.3",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/maker-bundle": ">=1.68"
  }
}
