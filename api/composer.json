{
  "name": "twes-in/api",
  "description": "twes-in invoicing API (Symfony + API Platform)",
  "license": "AGPL-3.0-or-later",
  "type": "project",
  "minimum-stability": "beta",
  "prefer-stable": true,
  "require": {
    "php": ">=8.6",
    "ext-bcmath": "*",
    "ext-ctype": "*",
    "ext-exif": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "api-platform/core": "^5.0.9",
    "doctrine/doctrine-bundle": "^3.4.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.7.6",
    "giggsey/libphonenumber-for-php-lite": "^9.0.43",
    "league/flysystem": "^3",
    "league/flysystem-async-aws-s3": "^3",
    "league/flysystem-local": "^3",
    "openspout/openspout": "^5.15.3",
    "sentry/sentry-symfony": "^5.15",
    "spomky-labs/otphp": "^11.5.1",
    "symfony/config": "8.2.*",
    "symfony/console": "8.2.*",
    "symfony/doctrine-messenger": "8.2.*",
    "symfony/dotenv": "8.2.*",
    "symfony/expression-language": "8.2.*",
    "symfony/flex": "^2.12",
    "symfony/framework-bundle": "8.2.*",
    "symfony/http-client": "8.2.*",
    "symfony/intl": "8.2.*",
    "symfony/lock": "8.2.*",
    "symfony/mailer": "8.2.*",
    "symfony/messenger": "8.2.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/rate-limiter": "8.2.*",
    "symfony/runtime": "8.2.*",
    "symfony/scheduler": "8.2.*",
    "symfony/security-bundle": "8.2.*",
    "symfony/translation": "8.2.*",
    "symfony/twig-bundle": "8.2.*",
    "symfony/uid": "8.2.*",
    "symfony/validator": "8.2.*",
    "symfony/yaml": "8.2.*",
    "web-auth/webauthn-lib": "^5.3.15"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "phpstan/extension-installer": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    },
    "files": [
      "config/container-secrets.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "lint": "php-cs-fixer check --diff",
    "lint:fix": "php-cs-fixer fix",
    "stan": [
      "Composer\\Config::disableProcessTimeout",
      "bin/console cache:warmup --env=test --no-interaction",
      "phpstan analyse --memory-limit=1G --no-progress"
    ],
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration --env=test",
      "bin/console app:database:app-role --no-interaction --env=test",
      "@php tests/parallel.php"
    ],
    "gate": [
      "@lint",
      "@stan",
      "@test"
    ],
    "gate:static": [
      "@lint",
      "@stan"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": "true",
      "require": "8.2.*"
    }
  },
  "require-dev": {
    "brianium/paratest": "^7.27.5",
    "dama/doctrine-test-bundle": ">=8.7.1",
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": ">=3.95.32",
    "phpstan/extension-installer": "*",
    "phpstan/phpstan": ">=2.3.7",
    "phpstan/phpstan-doctrine": ">=2.1.2",
    "phpstan/phpstan-symfony": ">=2.1.1",
    "phpunit/phpunit": "^13.4.8",
    "symfony/browser-kit": "8.2.*",
    "symfony/css-selector": "8.2.*",
    "symfony/maker-bundle": ">=1.68",
    "symfony/stopwatch": "8.2.*",
    "symfony/web-profiler-bundle": "8.2.*"
  }
}
