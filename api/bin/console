declare(strict_types=1);

use Symfony\Bundle\FrameworkBundle\Console\Application;
use Twes\Kernel;

/*
 * THE CONVENTIONAL SYMFONY CONSOLE ENTRY POINT. See `public/index.php` for why this uses
 * `vendor/autoload_runtime.php` -- and for the false claim it replaced, which asserted that `symfony/runtime`
 * could not be used in this container and thereby made FrankenPHP worker mode unreachable.
 *
 * The guard below is kept from the previous version, because the diagnostic it prints is genuinely hard-won: a
 * plain `composer install` fails here on a 403 from api.github.com, and that is AUTHORIZATION SCOPING rather
 * than a network block -- a distinction this project got wrong for twenty certification rounds.
 */
if (!is_file(dirname(__DIR__) . '/vendor/autoload_runtime.php')) {
    fwrite(STDERR, "vendor/autoload_runtime.php is missing.\n\n"
        . "It is generated by the `symfony/runtime` Composer plugin, which is allow-listed in composer.json.\n"
        . "If vendor/ is absent entirely, this container needs a specific incantation -- plain `composer install`\n"
        . "fails on a 403 from api.github.com, which is authorization scoping rather than a network block:\n\n"
        . "  composer config -g use-github-api false\n"
        . "  composer config -g github-protocols https\n"
        . "  cd api && composer install --prefer-source\n\n"
        . "If vendor/ is present but this file is not, the plugin did not run; `composer dump-autoload` restores it.\n"
        . "See CLAUDE.md § Gotchas -- the entry that had this wrong for twenty certification rounds.\n");

    exit(1);
}

require_once dirname(__DIR__) . '/vendor/autoload_runtime.php';

return static fn (array $context): Application => new Application(
    new Kernel($context['APP_ENV'], (bool) $context['APP_DEBUG']),
);
