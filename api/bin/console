declare(strict_types=1);

use Symfony\Bundle\FrameworkBundle\Console\Application;
use Symfony\Component\Dotenv\Dotenv;
use Twes\Kernel;

/*
 * BOOTSTRAPPED WITHOUT `symfony/runtime`, deliberately.
 *
 * The conventional Symfony entry point is `require vendor/autoload_runtime.php`, and that file does not exist
 * here: `symfony/runtime` generates it from a Composer PLUGIN, and plugins are disabled in this container
 * ("Composer plugins have been disabled for safety in this non-interactive session"). Rather than enable a
 * plugin to obtain a generated file, the eight lines it saves are written out.
 *
 * That is not merely a workaround -- it is the same argument this project already makes for hand-writing
 * `config/` instead of taking Flex recipes, and for XML mapping instead of attributes: the wiring is visible.
 * A reader can see exactly which env file is loaded and which class is constructed, with nothing generated in
 * between.
 */
if (!is_file(dirname(__DIR__) . '/vendor/autoload.php')) {
    fwrite(STDERR, "vendor/ is missing. This container needs a specific incantation -- plain `composer install`\n"
        . "fails on a 403 from api.github.com, which is authorization scoping rather than a network block:\n\n"
        . "  composer config -g use-github-api false\n"
        . "  composer config -g github-protocols https\n"
        . "  cd api && composer install --prefer-source --no-dev && composer dump-autoload --dev\n\n"
        . "See CLAUDE.md § Gotchas -- the entry that had this wrong for twenty certification rounds.\n");

    exit(1);
}

require_once dirname(__DIR__) . '/vendor/autoload.php';

(new Dotenv())->bootEnv(dirname(__DIR__) . '/.env');

$kernel = new Kernel($_SERVER['APP_ENV'] ?? 'dev', (bool) ($_SERVER['APP_DEBUG'] ?? true));

exit((new Application($kernel))->run());
