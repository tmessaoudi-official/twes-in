# Committed development defaults. Machine overrides go in .env.local (gitignored); tests read .env.test.
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8090

# Host-side defaults matching compose.yaml's published ports; inside the containers compose overrides these.
DATABASE_URL="postgresql://twes:twes@127.0.0.1:5433/twes?serverVersion=18&charset=utf8"
MAILER_DSN=smtp://127.0.0.1:8093
# The address the API sends its own mail from.
MAILER_SENDER=no-reply@twes.local

# Encrypts TOTP secrets at rest: 32 bytes, base64. Deliberately not APP_SECRET, which rotates for unrelated
# reasons and would silently invalidate every enrolled authenticator (ruling of 2026-09-10). This value is a
# committed DEVELOPMENT default and must be overridden in any real deployment; rotating it makes every
# enrolled TOTP secret unreadable, so rotation means re-enrolment.
APP_MFA_KEY=ojCIqjd0KzQ4JrX9wyEpy58LdtCAQ56MTwM8CWA0XOc=
