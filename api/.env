#
# DEFAULTS FOR LOCAL DEVELOPMENT ONLY, and every value here is a throwaway. This file is COMMITTED, so nothing
# in it may ever be a real credential: `.env.local` is gitignored and is where a real deployment puts its own.
#
# The DSN deliberately matches the one `api/phpunit.xml` uses for the integration suite, and connects as the
# RESTRICTED runtime role -- never as the owner. CLAUDE.md § Gotchas records that a single role owning the
# tenant-owned tables can DISABLE ROW LEVEL SECURITY or TRUNCATE them in one statement, so the application's own
# credential must not be able to. Migrations use a different role; see scripts/dev/provision-test-database.sh.
APP_ENV=dev
APP_SECRET=dev-only-not-a-secret-replace-in-env-local
APP_DEBUG=1

# `twes` is the restricted, non-owning runtime role. `serverVersion` is pinned so Doctrine does not have to
# connect in order to pick a platform -- which is what makes `doctrine:schema:validate` runnable without a
# database, and therefore usable in a gate.
DATABASE_URL="postgresql://twes:twes@127.0.0.1:5432/twes_in?serverVersion=18&charset=utf8"

# THE MIGRATION CREDENTIAL, and it is a SEPARATE ROLE rather than a nicety. `twes_owner` owns the tenant-owned
# tables; `twes` must never be able to, because a table's owner can `ALTER TABLE ... DISABLE ROW LEVEL SECURITY`
# in one statement and FORCE does not stop that (it stops an owner SKIPPING policies, not REMOVING them).
#
# This variable exists because the comment at the top of this file claimed "Migrations use a different role"
# while NOTHING implemented it, so `doctrine:migrations:migrate` with defaults ran as `twes` -- and it did:
# `doctrine_migration_versions` in the local `twes_in` database was owned by the runtime role on 2026-08-01.
# Prose asserting a control that nothing enforces is the shape CLAUDE.md § Gotchas records repeatedly, and
# `scripts/gates/schema-tenancy.php` now refuses ANY table owned by the runtime role for exactly this reason.
#
# `config/packages/doctrine.yaml` wires it as the `owner` connection and `doctrine_migrations.yaml` points
# migrations at it, so the safe role is the DEFAULT rather than something a developer must remember to pass.
DATABASE_URL_OWNER="postgresql://twes_owner:twes_owner@127.0.0.1:5432/twes_in?serverVersion=18&charset=utf8"
