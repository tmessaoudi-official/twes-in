# ==================================================================================================================
# THE COMMITTED BASE OF SYMFONY'S DOTENV CASCADE.
#
#     .env                 <- this file. Committed. Defaults for every environment. NEVER a real credential.
#     .env.local           <- gitignored. Your machine's overrides. This is where a real value goes.
#     .env.$APP_ENV        <- committed. Per-environment defaults (see .env.test).
#     .env.$APP_ENV.local  <- gitignored. Per-environment machine overrides.
#
# Later files win. There is no `.env.example` and there must not be one: that is a Laravel/Node convention, and in
# Symfony the committed file IS the template — `symfony/dotenv` reads `.env` directly and layers `.env.local` over
# it, so a separate example file would be a second copy nothing reads and everything drifts from.
#
# Loaded by `vendor/autoload_runtime.php` (see `public/index.php`) for the application — AND, since 2026-08-05, by an
# explicit `Dotenv::bootEnv()` in `tests/bootstrap.php` for the test suites. This line previously said "not by a
# hand-rolled `Dotenv::bootEnv()` call", which became false the moment the functional suite's hermeticity was fixed:
# without that call `phpunit.xml` supplies no `TRUSTED_PROXIES` or `DEFAULT_LOCALE` and booting the kernel raises
# `EnvNotFoundException`. Edited in place rather than corrected below, per CLAUDE.md § Gotchas.
# ==================================================================================================================

# --- Application ----------------------------------------------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=dev-only-not-a-secret-replace-in-env-local

# THE RUNTIME. `SymfonyRuntime` is the default and is what `autoload_runtime.php` selects when this is unset; it
# is named explicitly so the seam is visible. FrankenPHP's WORKER MODE is switched on by setting this to
# `Runtime\FrankenPhpSymfony\Runtime` — see `infra/api/Caddyfile` for THREE preconditions still owed before that
# is safe here: a Symfony 8 release of `runtime/frankenphp-symfony`, proof that a tenant cannot stay bound to a
# connection a resident kernel reuses, and — the binding one — the client portal's own `random_bytes(32)` token.
# `UuidV7` seeds its generator state once per PROCESS, so a worker serving many requests lets a seed recoverable
# from ~24 observed identifiers span TENANTS. `scripts/gates/worker-mode-blocked.sh` REFUSES any other value in
# EVERY tracked file -- this one included, and including `.env.local`/`.env.prod`, which a pattern anchored
# `\.env$` missed while `api/.env.prod` reached production worker mode with both gates green.
# `scripts/gates/compose-config.sh` covers the RENDERED compose environment. CLAUDE.md Gotchas 2026-08-05.
APP_RUNTIME=Symfony\Component\Runtime\SymfonyRuntime

# `en` is the SOURCE language of `translations/`; `fr` and `ar` are translations of it.
DEFAULT_LOCALE=en

# --- Database -------------------------------------------------------------------------------------------------
# `twes` is the restricted, non-owning runtime role. `serverVersion` is pinned so Doctrine does not have to
# connect in order to pick a platform -- which is what makes `doctrine:schema:validate` runnable without a
# database, and therefore usable in a gate.
DATABASE_URL="postgresql://twes:twes@127.0.0.1:5432/twes_in?serverVersion=18&charset=utf8"

# THE MIGRATION CREDENTIAL, and it is a SEPARATE ROLE rather than a nicety. `twes_owner` owns the tenant-owned
# tables; `twes` must never be able to, because a table's owner can `ALTER TABLE ... DISABLE ROW LEVEL SECURITY`
# in one statement and FORCE does not stop that (it stops an owner SKIPPING policies, not REMOVING them).
#
# This variable exists because the comment at the top of this file claimed "Migrations use a different role"
# while NOTHING implemented it, so `doctrine:migrations:migrate` with defaults ran as `twes` -- and it did:
# `doctrine_migration_versions` in the local `twes_in` database was owned by the runtime role on 2026-08-01.
# Prose asserting a control that nothing enforces is the shape CLAUDE.md § Gotchas records repeatedly, and
# `scripts/gates/schema-tenancy.php` now refuses ANY table owned by the runtime role for exactly this reason.
#
# `config/packages/doctrine.yaml` wires it as the `owner` connection and `doctrine_migrations.yaml` points
# migrations at it, so the safe role is the DEFAULT rather than something a developer must remember to pass.
DATABASE_URL_OWNER="postgresql://twes_owner:twes_owner@127.0.0.1:5432/twes_in?serverVersion=18&charset=utf8"

# --- Messenger ------------------------------------------------------------------------------------------------
# DOCTRINE, not Valkey, and `config/packages/messenger.yaml` gives the three reasons at length. The short one:
# Valkey runs with persistence disabled on purpose, so it cannot be the durable store the failure transport has
# to be.
#
# `auto_setup=false` is a SECURITY setting. Auto-setup issues `CREATE TABLE` on the RUNTIME connection, which
# would make the restricted role the table's owner -- and `scripts/gates/schema-tenancy.php` refuses ANY table
# owned by that role. The table is created by a migration running on the `owner` connection instead.
MESSENGER_TRANSPORT_DSN="doctrine://default?auto_setup=false"

# --- Lock -----------------------------------------------------------------------------------------------------
# VALKEY for this one, which is the opposite choice from the queue above and deliberately so: a lock SHOULD be
# lost on a restart, because a persisted lock resurrects one held by a process that no longer exists.
# `flock` locally, so a developer needs nothing running; the compose stack overrides this to Valkey.
LOCK_DSN=flock

# --- HTTP -----------------------------------------------------------------------------------------------------
# Empty locally: nothing sits in front of `php -S` or the test client, and trusting a proxy that is not there
# would let any caller forge `X-Forwarded-For` and so forge their own client IP. `infra/.env` sets `REMOTE_ADDR`
# for the containerised stack, where FrankenPHP genuinely is the only thing that can reach the application.
TRUSTED_PROXIES=
