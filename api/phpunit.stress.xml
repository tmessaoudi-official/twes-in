<?xml version="1.0" encoding="UTF-8"?>

<!-- The race tests (tests/Concurrency), run by make stress on their own database, twes_test_stress: no DAMA extension,
     since racers in processes of their own must see each other's commits. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
>
    <php>
        <ini name="display_errors" value="1" />
        <ini name="error_reporting" value="-1" />
        <ini name="date.timezone" value="UTC" />
        <server name="APP_ENV" value="test" force="true" />
        <server name="SHELL_VERBOSITY" value="-1" />
        <server name="TEST_TOKEN" value="_stress" force="true" />
        <env name="TEST_TOKEN" value="_stress" force="true" />
    </php>

    <testsuites>
        <testsuite name="Concurrency">
            <directory>tests/Concurrency</directory>
        </testsuite>
    </testsuites>
</phpunit>
