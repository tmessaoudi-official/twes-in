{# A delivery note on A4, rendered by Gotenberg's Chromium. Everything it says comes from translations/pdf and fiscal
   in the note's language; amounts go through the decimal filter, never through a float. Nothing here runs a script. #}
{%- set t = 'pdf' -%}
{#- The company's date and number format win over the language's. -#}
{%- set dateFormat = date_pattern(page.dateFormat, 'format.date'|trans({}, t, locale)) -%}
<!DOCTYPE html>
<html lang="{{ locale }}" dir="{{ text_direction(locale) }}">
<head>
  <meta charset="utf-8">
  <title>{{ 'delivery_note.title'|trans({}, t, locale) }} {{ note.number }}</title>
  <style>
    @page { size: A4; }
{% include 'pdf/_document.css.twig' with {design: page.design} only %}
    .totals { width: 50%; }
    .reception { margin-top: 24px; break-inside: avoid; }
    .reception h2 { font-size: 9pt; margin: 0 0 4px; }
    .reception table { margin: 0; }
    .reception td { width: 33.33%; height: 30mm; vertical-align: top; border: 1px solid #afb8c1; padding: 6px; font-size: 8pt; color: #57606a; }
    .reception .reserves { height: 18mm; border: 1px solid #afb8c1; border-top: 0; padding: 6px; font-size: 8pt; color: #57606a; }
    .reception .filled { margin-top: 6px; font-size: 10pt; color: #1f2328; }
    .copy-mark { margin: 0 0 8px; font-weight: 700; letter-spacing: .05em; color: #cf222e; }
  </style>
</head>
<body class="{{ 'layout-' ~ page.design.layout.value }}">
  {%- include 'pdf/_demo_band.html.twig' with {demo: demo, t: t, locale: locale} only %}
  {%- if page.watermark %}
    {% include 'pdf/_watermark.html.twig' with {text: ('watermark.' ~ page.watermark)|trans({}, t, locale), look: page.design.watermark} only %}
  {%- endif %}
  {%- if page.deliveredCopy and note.deliveredAt %}
    <p class="copy-mark" data-testid="copy-mark">{{ 'copy.delivered'|trans({'%date%': note.deliveredAt|date(dateFormat, note.company.timezone)}, t, locale) }}</p>
  {%- endif %}

  <div class="parties">
    <div class="party">
      {%- if logo %}<img class="logo" src="{{ logo }}" alt="">{% endif %}
      <div class="company-name">{{ seller.printedName }}</div>
      {%- for key, value in seller.identifiers %}
        <div>{{ ('fiscal.identifier.' ~ country ~ '.' ~ key)|trans({}, 'fiscal', locale) }} : <bdi>{{ value }}</bdi></div>
      {%- endfor %}
      {%- if seller.address.line1 %}
        <div><bdi>{{ seller.address.line1 }}</bdi></div>
        {% if seller.address.line2 %}<div><bdi>{{ seller.address.line2 }}</bdi></div>{% endif %}
        <div><bdi>{{ seller.address.postalCode }} {{ seller.address.city }}</bdi></div>
      {%- endif %}
      {% if seller.phone %}<div>{{ 'company.phone'|trans({}, t, locale) }} <bdi dir="ltr">{{ seller.phone }}</bdi></div>{% endif %}
      {% if seller.email %}<div>{{ 'company.email'|trans({}, t, locale) }} <bdi>{{ seller.email }}</bdi></div>{% endif %}
    </div>
    <div class="party">
      <h2>{{ 'delivery_note.customer'|trans({}, t, locale) }}</h2>
      <div class="company-name">{{ customer.legalName ?? customer.name }}</div>
      {% if customer.legalName %}<div>{{ customer.name }}</div>{% endif %}
      <div class="muted">{{ 'delivery_note.customer_number'|trans({}, t, locale) }} <bdi>{{ customer.number }}</bdi></div>
      {%- for key, value in customer.identifiers %}
        <div>{{ ('fiscal.identifier.' ~ country ~ '.' ~ key)|trans({}, 'fiscal', locale) }} : <bdi>{{ value }}</bdi></div>
      {%- endfor %}
      {%- set billing = customer.billingAddress %}
      {% if billing.line1 %}<div><bdi>{{ billing.line1 }}</bdi></div>{% endif %}
      {% if billing.line2 %}<div><bdi>{{ billing.line2 }}</bdi></div>{% endif %}
      {% if billing.postalCode or billing.city %}<div><bdi>{{ billing.postalCode }} {{ billing.city }}</bdi></div>{% endif %}
      {%- set delivery = header.deliveryAddress %}
      {%- if not delivery.isEmpty() %}
        <h2 style="margin-top: 10px;">{{ 'delivery_note.delivery_address'|trans({}, t, locale) }}</h2>
        {% if delivery.line1 %}<div><bdi>{{ delivery.line1 }}</bdi></div>{% endif %}
        {% if delivery.line2 %}<div><bdi>{{ delivery.line2 }}</bdi></div>{% endif %}
        <div><bdi>{{ delivery.postalCode }} {{ delivery.city }}</bdi>{% if delivery.countryCode and delivery.countryCode|lower != country %} {{ delivery.countryCode }}{% endif %}</div>
      {%- endif %}
    </div>
  </div>

  <div class="title">
    <h1>{{ 'delivery_note.title'|trans({}, t, locale) }}</h1>
    {% if note.number %}<strong><bdi>{{ note.number }}</bdi></strong>{% endif %}
  </div>

  <dl class="facts">
    {% if note.issueDate %}<div><dt>{{ 'delivery_note.issue_date'|trans({}, t, locale) }}</dt><dd>{{ note.issueDate|date(dateFormat, 'UTC') }}</dd></div>{% endif %}
    {#- Once delivered, when, to the minute on the company's clock: the seconds are kept, never printed. -#}
    {% if note.deliveredAt %}<div><dt>{{ 'delivery_note.delivery_date'|trans({}, t, locale) }}</dt><dd>{{ note.deliveredAt|date(dateFormat ~ ' H:i', note.company.timezone) }}</dd></div>
    {% elseif header.deliveryDate %}<div><dt>{{ 'delivery_note.delivery_date'|trans({}, t, locale) }}</dt><dd>{{ header.deliveryDate|date(dateFormat, 'UTC') }}</dd></div>{% endif %}
    {% if page.quoteNumber %}<div><dt>{{ 'delivery_note.quote'|trans({}, t, locale) }}</dt><dd><bdi>{{ page.quoteNumber }}</bdi></dd></div>{% endif %}
    {% if page.invoiceNumber %}<div><dt>{{ 'delivery_note.invoice'|trans({}, t, locale) }}</dt><dd><bdi>{{ page.invoiceNumber }}</bdi></dd></div>{% endif %}
    {% if header.customerReference %}<div><dt>{{ 'delivery_note.customer_reference'|trans({}, t, locale) }}</dt><dd><bdi>{{ header.customerReference }}</bdi></dd></div>{% endif %}
  </dl>

  <table>
    <thead>
      <tr>
        <th>{{ 'line.description'|trans({}, t, locale) }}</th>
        <th class="number">{{ 'line.quantity'|trans({}, t, locale) }}</th>
        <th>{{ 'line.unit'|trans({}, t, locale) }}</th>
        {%- if page.showPrices %}
          <th class="number">{{ 'line.unit_price'|trans({}, t, locale) }}</th>
          <th>{{ 'line.taxes'|trans({}, t, locale) }}</th>
          <th class="number">{{ 'line.net'|trans({}, t, locale) }}</th>
        {%- endif %}
      </tr>
    </thead>
    <tbody>
      {%- for line in note.lines %}
        <tr>
          <td><bdi>{{ line.description|nl2br }}</bdi></td>
          <td class="number">{{ line.quantity|decimal(line.unit.decimals, locale, page.numberFormat) }}</td>
          <td>{{ page.names.unit(line.unit) }}</td>
          {%- if page.showPrices %}
            <td class="number">{{ line.unitPriceNet|decimal(scale, locale, page.numberFormat) }}</td>
            <td>{% for tax in line.taxes %}{{ loop.first ? '' : 'format.list_separator'|trans({}, t, locale) }}<bdi>{{ tax_label(page.names.taxes[tax.code] ?? tax.code, tax.rate, locale, page.numberFormat) }}</bdi>{% endfor %}</td>
            <td class="number">{{ page.totals.lines[loop.index0].net|decimal(scale, locale, page.numberFormat) }}</td>
          {%- endif %}
        </tr>
      {%- endfor %}
    </tbody>
  </table>
  {%- include 'pdf/_quantities.html.twig' with {quantities: page.quantities, t: t, locale: locale, numberFormat: page.numberFormat} only %}

  {%- if page.showPrices %}
    <table class="totals">
      <tr><td>{{ 'totals.subtotal'|trans({}, t, locale) }}</td><td class="number">{{ page.totals.subtotalNet|decimal(scale, locale, page.numberFormat) }}</td></tr>
      {%- for tax in page.totals.taxes %}
        <tr>
          <td><bdi>{{ tax_label(page.names.taxes[tax.code] ?? tax.code, tax.rate.percentage(), locale, page.numberFormat) }}</bdi> <span class="muted">({{ tax.base|decimal(scale, locale, page.numberFormat) }})</span></td>
          <td class="number">{{ tax.amount|decimal(scale, locale, page.numberFormat) }}</td>
        </tr>
      {%- endfor %}
      <tr><td>{{ 'totals.total_tax'|trans({}, t, locale) }}</td><td class="number">{{ page.totals.totalTax|decimal(scale, locale, page.numberFormat) }}</td></tr>
      <tr class="grand"><td>{{ 'totals.total'|trans({}, t, locale) }}</td><td class="number">{{ page.totals.total|decimal(scale, locale, page.numberFormat) }}</td></tr>
    </table>
    <p class="muted">{{ 'totals.currency'|trans({'%currency%': seller.currency}, t, locale) }}</p>
  {%- endif %}

  {%- if customer.taxMentionKey %}
    {%- set mention = customer.taxMentionKey|trans(page.exemptionReference is null ? {} : {'%reference%': page.exemptionReference}, 'fiscal', locale) %}
    {#- A mention still waiting for its parameters (a legal reference) is not printed half-written. #}
    {%- if not (mention matches '/%[a-z_]+%/') %}
      <p class="mention">{{ mention }}</p>
    {%- endif %}
  {%- endif %}

  {%- if header.remarksPrinted or page.printedNotes %}
    <div class="remarks">
      <h2 class="muted" style="font-size: 9pt; margin: 0 0 4px;">{{ 'delivery_note.remarks'|trans({}, t, locale) }}</h2>
      {% if header.remarksPrinted %}<p dir="auto" style="margin: 0;">{{ header.remarksPrinted|nl2br }}</p>{% endif %}
      {% if page.printedNotes %}<p dir="auto" style="margin: 4px 0 0;">{{ page.printedNotes|nl2br }}</p>{% endif %}
    </div>
  {%- endif %}

  {#- Who received, on a line of its own where no reception block prints a cell for it. #}
  {%- if page.receiverName and not page.receptionBlock %}
    <p data-testid="received-by">{{ 'delivery_note.received_by'|trans({}, t, locale) }} <bdi>{{ page.receiverName }}</bdi></p>
  {%- endif %}

  {#- The reception block: three cells and a line for réserves, a delivery setting, on by default. « Nom » carries who
      received when one is named; a delivered copy fills the moment too. #}
  {%- if page.receptionBlock %}
    <section class="reception">
      <h2>{{ 'delivery_note.reception.title'|trans({}, t, locale) }}</h2>
      <table>
        <tr>
          <td>{{ 'delivery_note.reception.when'|trans({}, t, locale) }}{% if page.deliveredCopy and note.deliveredAt %}<div class="filled">{{ note.deliveredAt|date(dateFormat ~ ' H:i', note.company.timezone) }}</div>{% endif %}</td>
          <td>{{ 'delivery_note.reception.name'|trans({}, t, locale) }}{% if page.receiverName %}<div class="filled" data-testid="received-by"><bdi>{{ page.receiverName }}</bdi></div>{% endif %}</td>
          <td>{{ 'delivery_note.reception.signature'|trans({}, t, locale) }}</td>
        </tr>
      </table>
      <div class="reserves">{{ 'delivery_note.reception.reserves'|trans({}, t, locale) }}</div>
    </section>
  {%- endif %}
</body>
</html>
