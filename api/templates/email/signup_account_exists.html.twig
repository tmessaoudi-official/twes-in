{# Mailed instead of a signup link when the address already has an account, so the answer to the request is the same. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #111;">
    <h1 style="font-size: 20px;">{{ 'signup.account_exists.heading'|trans({}, 'emails') }}</h1>
    <p>{{ 'signup.account_exists.intro'|trans({'%product%': productName}, 'emails') }}</p>
    <p>
      <a href="{{ loginUrl }}" style="display: inline-block; padding: 10px 16px; background: #1a56db; color: #fff; text-decoration: none; border-radius: 6px;">
        {{ 'signup.account_exists.call_to_action'|trans({}, 'emails') }}
      </a>
    </p>
    <p style="font-size: 13px; color: #555;">{{ 'signup.account_exists.ignore'|trans({}, 'emails') }}</p>
    <p style="font-size: 12px; color: #888;">{{ productName }}</p>
  </body>
</html>
