{# The invitation mail. Plain, inline-styled HTML: mail clients strip stylesheets, and this has one job. #}
<!DOCTYPE html>
<html lang="{{ app.locale }}" dir="{{ text_direction(app.locale) }}">
  <body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #111;">
    <div dir="{{ text_direction(app.locale) }}" lang="{{ app.locale }}">
      <h1 style="font-size: 20px;">{{ 'invitation.heading'|trans({'%company%': companyName}, 'emails') }}</h1>
      {% if invitedByName %}
        <p>{{ 'invitation.invited_by'|trans({'%name%': invitedByName}, 'emails') }}</p>
      {% endif %}
      <p>{{ 'invitation.role'|trans({'%role%': roleName|trans({}, 'roles')}, 'emails') }}</p>
      <p>
        <a href="{{ acceptUrl }}" style="display: inline-block; padding: 10px 16px; background: #1a56db; color: #fff; text-decoration: none; border-radius: 6px;">
          {{ 'invitation.call_to_action'|trans({}, 'emails') }}
        </a>
      </p>
      <p style="font-size: 13px; color: #555;">{{ 'invitation.expires'|trans({'%date%': expiresAt|date('d/m/Y H:i', timezone)}, 'emails') }}</p>
      <p style="font-size: 13px; color: #555;">{{ 'invitation.ignore'|trans({}, 'emails') }}</p>
      <p dir="auto" style="font-size: 12px; color: #888;">{{ productName }}</p>
    </div>
  </body>
</html>
