{# The mail a company's owners receive once the operator has decided on the payment they declared. #}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}">
  <body style="font-family: system-ui, sans-serif; line-height: 1.5; color: #111;">
    {% if confirmed %}
      <h1 style="font-size: 20px;">{{ 'payment_decided.confirmed_heading'|trans({'%amount%': amount, '%currency%': currency}, 'emails') }}</h1>
      {% if paidThrough %}
        <p>{{ 'payment_decided.paid_through'|trans({'%company%': companyName, '%date%': paidThrough}, 'emails') }}</p>
      {% endif %}
    {% else %}
      <h1 style="font-size: 20px;">{{ 'payment_decided.rejected_heading'|trans({'%amount%': amount, '%currency%': currency}, 'emails') }}</h1>
      <p>{{ 'payment_decided.rejected_intro'|trans({'%company%': companyName}, 'emails') }}</p>
    {% endif %}
    {% if note %}
      <p>{{ 'payment_decided.note'|trans({'%note%': note}, 'emails') }}</p>
    {% endif %}
    <p>
      <a href="{{ loginUrl }}" style="display: inline-block; padding: 10px 16px; background: #1a56db; color: #fff; text-decoration: none; border-radius: 6px;">
        {{ 'payment_decided.call_to_action'|trans({}, 'emails') }}
      </a>
    </p>
    <p style="font-size: 12px; color: #888;">{{ productName }}</p>
  </body>
</html>
