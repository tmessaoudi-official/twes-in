# ==================================================================================================================
# TEST-ENVIRONMENT DEFAULTS. Committed, and loaded after `.env` whenever `APP_ENV=test`.
#
# WHY THIS FILE EXISTS AT ALL, given `phpunit.xml` already carries `<env>` entries. Because those entries are
# INVISIBLE OUTSIDE PHPUNIT, and `CLAUDE.md` § "Quality gate" records the cost of that directly: `composer gate`
# fails at `gate:schema` because the documented `TWES_TEST_DSN` fallback names PHPUnit `<env>` entries that no
# shell can see. A `.env.test` is the Symfony-conventional place for test configuration precisely because
# `bin/console --env=test` and any script that boots the kernel read it too.
#
# The database-topology variables (`TWES_TEST_DB_*`) deliberately stay in `phpunit.xml`: they configure the
# ISOLATION FIXTURE rather than the application, nothing outside the integration suite consumes them, and
# `CLAUDE.md` names that file as the tally to derive them from.
# ==================================================================================================================

APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-secret-not-used-for-anything-signed

# IN-MEMORY for the test run. A test that dispatches a message must not reach PostgreSQL for it: the Doctrine
# transport would need its table present, which couples every functional test to a migrated database for no
# benefit. `in-memory://` collects dispatched messages so a test can assert on them instead.
MESSENGER_TRANSPORT_DSN=in-memory://

# `flock` needs no service. A test that exercises real contention will ask for a different store explicitly.
LOCK_DSN=flock
