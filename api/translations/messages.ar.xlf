<?xml version="1.0" encoding="UTF-8"?>
<!--
  Arabic. Tunisia is a first-wave jurisdiction and TND is the default currency, so this is a shipped
  catalogue. Arabic is also why RTL is in scope from Wave 0: it reaches the Angular admin, the Flutter
  client AND the generated PDF documents, and bidirectional text with Arabic glyph shaping inside a
  generated PDF is the single most underestimated item in this project's i18n scope. It must be proven
  with a rendered document, never asserted.
-->
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="ar" datatype="plaintext" original="twes-in">
    <body>
      <trans-unit id="1" resname="error.validation_failed">
        <source>error.validation_failed</source>
        <target>البيانات المُرسلة غير صالحة.</target>
      </trans-unit>
      <trans-unit id="2" resname="error.not_found">
        <source>error.not_found</source>
        <target>المورد المطلوب غير موجود.</target>
      </trans-unit>
      <trans-unit id="3" resname="error.tenant_required">
        <source>error.tenant_required</source>
        <target>هذا الطلب غير مرتبط بأي شركة.</target>
      </trans-unit>
      <trans-unit id="4" resname="error.internal">
        <source>error.internal</source>
        <target>حدث خطأ داخلي.</target>
      </trans-unit>
      <trans-unit id="5" resname="money.amount_not_representable">
        <source>money.amount_not_representable</source>
        <target>لا يمكن تمثيل المبلغ {amount} بدقة بعملة {currency}.</target>
      </trans-unit>
      <trans-unit id="6" resname="money.currency_unknown">
        <source>money.currency_unknown</source>
        <target>العملة {code} غير مدعومة.</target>
      </trans-unit>
      <trans-unit id="7" resname="money.currency_mismatch">
        <source>money.currency_mismatch</source>
        <target>لا يمكن الجمع بين مبالغ بعملتي {left} و {right} دون سعر صرف.</target>
      </trans-unit>
      <trans-unit id="8" resname="pricing.rate_too_precise">
        <source>pricing.rate_too_precise</source>
        <target>النسبة {rate} تحتوي على خانات عشرية أكثر مما يمكن تخزينه.</target>
      </trans-unit>
      <trans-unit id="9" resname="pricing.profit_rate_undefined">
        <source>pricing.profit_rate_undefined</source>
        <target>نسبة الربح غير معرّفة عندما تكون الكلفة صفراً.</target>
      </trans-unit>
      <trans-unit id="10" resname="document.illegal_transition">
        <source>document.illegal_transition</source>
        <target>لا يمكن نقل هذه الوثيقة من {from} إلى {to}. التصحيح وثيقة جديدة، وليس تعديلاً.</target>
      </trans-unit>
      <trans-unit id="15" resname="document.empty_cannot_be_issued">
        <source>document.empty_cannot_be_issued</source>
        <target>هذه الفاتورة لا تحتوي على أي بند، لذلك لا يمكن إصدارها. الإصدار يستهلك نهائياً رقم وثيقة لا يُعاد استخدامه أبداً. أضف بنداً، أو احذف المسوّدة.</target>
      </trans-unit>
      <trans-unit id="16" resname="document.quantity_too_precise">
        <source>document.quantity_too_precise</source>
        <target>الكمية {quantity} تحتوي على عدد كبير جداً من الخانات العشرية (الحد الأقصى {max}). الكمية هي عدد أو قياس — ساعات، كيلوغرامات، لترات.</target>
      </trans-unit>
      <trans-unit id="17" resname="document.quantity_too_large">
        <source>document.quantity_too_large</source>
        <target>الكمية {quantity} كبيرة جداً. مع سعر الوحدة ستنتج مبلغاً إجمالياً لا يمكن للنظام تمثيله.</target>
      </trans-unit>
      <trans-unit id="18" resname="document.unit_price_negative">
        <source>document.unit_price_negative</source>
        <target>سعر الوحدة {price} سالب. لرد مبلغ إلى عميل، أصدر إشعار دائن بدلاً من بند سالب.</target>
      </trans-unit>
      <trans-unit id="19" resname="document.charge_amount_negative">
        <source>document.charge_amount_negative</source>
        <target>الرسم {label} له مبلغ سالب ({amount}). الرسم يُضاف إلى الإجمالي؛ لتخفيضه، استخدم إشعار دائن.</target>
      </trans-unit>
      <trans-unit id="20" resname="document.charge_label_empty">
        <source>document.charge_label_empty</source>
        <target>يجب أن يكون للرسم عنوان. فهو ما يُعرّف الرسم ويشرحه، حتى لا يظهر في الفاتورة مبلغ لا يمكن تبريره.</target>
      </trans-unit>
      <trans-unit id="35" resname="document.charge_label_too_long">
        <source>document.charge_label_too_long</source>
        <target>عنوان الرسم «{label}» يتكون من {length} حرفًا، والحد الأقصى المسموح به هو {max}. العنوان يُعرّف الرسم — مثل «stamp_duty» أو «late_fee» — ولا يصفه في جملة كاملة.</target>
      </trans-unit>
      <trans-unit id="21" resname="document.line_not_found">
        <source>document.line_not_found</source>
        <target>لا يوجد بند في الموضع {position} — الوثيقة تحتوي على {count}. قد تكون الصفحة قديمة؛ أعد تحميلها وحاول مرة أخرى.</target>
      </trans-unit>
      <trans-unit id="22" resname="document.number_pattern_invalid">
        <source>document.number_pattern_invalid</source>
        <target>يجب أن يكون عرض رقم الوثيقة 1 على الأقل. العرض صفر سيطبع كل رقم بدون تعبئة مع الظهور كأنه مُهيّأ.</target>
      </trans-unit>
      <trans-unit id="34" resname="document.number_pattern_too_wide">
        <source>document.number_pattern_too_wide</source>
        <target>يجب أن يكون عرض رقم الوثيقة {max} على الأكثر، وقد أُعطي {width}. رقم الوثيقة يُقرأ بصوت عالٍ ويُدخل في تحويل بنكي ويُطبع في عمود؛ {max} رقماً تكفي لترقيم كل الفواتير التي سيصدرها المستأجر.</target>
      </trans-unit>
      <trans-unit id="23" resname="document.state.draft">
        <source>document.state.draft</source>
        <target>مسوّدة</target>
      </trans-unit>
      <trans-unit id="24" resname="document.state.issued">
        <source>document.state.issued</source>
        <target>صادرة</target>
      </trans-unit>
      <trans-unit id="25" resname="document.state.cancelled">
        <source>document.state.cancelled</source>
        <target>ملغاة</target>
      </trans-unit>
      <trans-unit id="26" resname="document.line_total_too_large">
        <source>document.line_total_too_large</source>
        <target>إجمالي البند للكمية {quantity} بسعر {price} للوحدة كبير جداً بحيث لا يمكن تمثيله. قلّل أحدهما.</target>
      </trans-unit>
      <trans-unit id="27" resname="document.total_too_large">
        <source>document.total_too_large</source>
        <target>سيكون إجمالي هذه الوثيقة كبيراً جداً بحيث لا يمكن تمثيله. احذف بنداً أو رسماً، أو قسّمها إلى وثيقتين.</target>
      </trans-unit>
      <trans-unit id="28" resname="pricing.rate_invalid">
        <source>pricing.rate_invalid</source>
        <target>النسبة {rate} ليست رقماً صالحاً. أدخل نسبة مئوية باستخدام الفاصلة العشرية، مثل 19 أو 7.5.</target>
      </trans-unit>
      <trans-unit id="29" resname="pricing.rate_too_large">
        <source>pricing.rate_too_large</source>
        <target>النسبة {rate} كبيرة جداً. نسبة بهذا الحجم تكون غالباً خطأ في الإدخال.</target>
      </trans-unit>
      <trans-unit id="30" resname="pricing.cost_negative">
        <source>pricing.cost_negative</source>
        <target>التكلفة {cost} سالبة. التكلفة هي ما دفعته؛ أدخل صفراً إذا كان العنصر مجانياً.</target>
      </trans-unit>
      <trans-unit id="31" resname="pricing.net_price_not_representable">
        <source>pricing.net_price_not_representable</source>
        <target>هذه التكلفة ونسبة الربح تعطيان سعر بيع كبيراً جداً بحيث لا يمكن تمثيله. خفّض أحدهما.</target>
      </trans-unit>
      <trans-unit id="11" resname="document.not_mutable">
        <source>document.not_mutable</source>
        <target>هذه الوثيقة في حالة «{state}» ولم يعد من الممكن تغييرها. ألغها وأصدر وثيقة جديدة بالمبالغ الصحيحة.</target>
      </trans-unit>
      <trans-unit id="12" resname="document.quantity_invalid">
        <source>document.quantity_invalid</source>
        <target>الكمية {quantity} غير صالحة. أدخل رقماً موجباً باستخدام الفاصلة العشرية.</target>
      </trans-unit>
      <trans-unit id="13" resname="document.vat_rate_invalid">
        <source>document.vat_rate_invalid</source>
        <target>نسبة الضريبة {rate}% غير صالحة. لا تكون نسبة الضريبة سالبة أبداً.</target>
      </trans-unit>
      <trans-unit id="14" resname="pricing.net_price_negative">
        <source>pricing.net_price_negative</source>
        <target>تكلفة {cost} بنسبة ربح {rate}% تعطي سعر بيع {price}. لا يُباع المنتج بسعر سالب؛ استخدم إشعار دائن.</target>
      </trans-unit>
      <trans-unit id="32" resname="document.line_count_too_large">
        <source>document.line_count_too_large</source>
        <target>تحتوي هذه الوثيقة بالفعل على {max} بند، وهذا هو الحد الأقصى. احذف بنداً، أو قسّمها إلى وثيقتين.</target>
      </trans-unit>
      <trans-unit id="33" resname="document.charge_count_too_large">
        <source>document.charge_count_too_large</source>
        <target>تحتوي هذه الوثيقة بالفعل على {max} رسم، وهذا هو الحد الأقصى. احذف رسماً، أو قسّمها إلى وثيقتين.</target>
      </trans-unit>
      <trans-unit id="36" resname="client.name_required">
        <source>client.name_required</source>
        <target>يجب أن يكون للعميل اسم، فهو الاسم الذي تُوجَّه إليه الفاتورة.</target>
      </trans-unit>
      <trans-unit id="37" resname="client.name_too_long">
        <source>client.name_too_long</source>
        <target>اسم العميل مكوَّن من {count} حرفًا، والحد الأقصى المسموح به {max} حرفًا.</target>
      </trans-unit>
      <trans-unit id="38" resname="client.tax_identifier_too_long">
        <source>client.tax_identifier_too_long</source>
        <target>المعرِّف الجبائي مكوَّن من {count} حرفًا، والحد الأقصى المسموح به {max} حرفًا.</target>
      </trans-unit>
      <trans-unit id="39" resname="client.address_line_1_required">
