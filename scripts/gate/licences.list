# SPDX-License-Identifier: AGPL-3.0-or-later
# The licence half of the gate (`make gate-licences`, CI's licences job), run by scripts/gate/run-list.sh: one line per
# check, `<kind> <mode> <command>`. kind: gate (a check of the tree, also what a docs-only change is gated by) or test
# (a gate's own test, on fixtures of its own). mode: first (alone, before anything, a red stops the list), long (started
# first: the slowest), parallel, serial (alone, after the others: it starts docker, docker-compose or make, or writes
# outside its own temporary folder; the runner reds a parallel line that starts one of the three).
# Each test runs through no-leftovers.sh: TMPDIR outlives every run on the host's tmpfs, and a test leaving a directory
# per case used its inodes up until no shell on the machine could start.

test first bash scripts/gates/tests/no-leftovers.test.sh
test parallel bash scripts/gates/tests/no-leftovers.sh scripts/gates/tests/dependency-licences.test.sh
test parallel bash scripts/gates/tests/no-leftovers.sh scripts/gates/tests/spdx-headers.test.sh
