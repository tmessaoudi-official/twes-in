#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# A shop's installation on its own computer (docs/START.md § 16): what its scheduled tasks and its shortcuts run.
#   twes start                     reads this machine's network address, then starts the release deployed here again,
#                                  nothing fetched, so a morning without the internet still opens
#   twes update                    the newest release tag: the database and the files backed up first (their label kept),
#                                  the release deployed by digest, its deep health read through the edge; unhealthy,
#                                  the release it left is started again on the current schema and the developer told
#   twes policy auto HH:MM-HH:MM   updates applied by tick inside that daily window, in the shop's time
#   twes policy notify | off       the owners told in the app that a release is out, or nothing
#   twes offsite on | off          the off-site copy of the backups (its bucket's values given first)
#   twes tick                      every quarter hour: a new network address, alerts held back, deep health (failing, the
#                                  installation started again once before anyone is told), the backups' outcomes and their
#                                  schedule, then the update policy
#   twes status                    what runs, its policy, address, health and backups
#   twes restore-commands          what takes the installation back to the backup made before the last update
#   twes hold on | off             a restore under way: tick and update act on nothing and start refuses, the start at
#                                  boot included, until the hold ends; the restore's own commands hold and end it
#   twes pin-key <file>            pins the developer's public release key: every release tag must verify against it
#   twes install                   asks for the shop's facts, writes the values, pins the release key once its fingerprint
#                                  is confirmed, installs the newest release and makes the operator; run again, it asks
#                                  only what is still missing; on Linux and under Docker Engine in WSL, schedules start
#                                  and tick as well
#   twes schedule                  Linux, and Docker Engine inside WSL's Ubuntu: systemd units running twes start at boot
#                                  and twes tick every quarter hour, as this account, once Docker runs (sudo asks for the
#                                  password); with Docker Desktop, Windows' tasks are install.ps1's
# The values are the file scripts/deploy/new-instance.sh --onprem wrote, TWES_VALUES, by default ~/.twes-in/install.env;
# beside it, releases/ (deploy.sh's record) and state/ (this script's). Alerts are mailed through the shop's own account
# to ALERT_EMAIL, so a mail leaves while the application is down, and recorded in the application, held under state/
# until it answers. Every secret it hands to curl goes through a file of mode 600, never the command line. A release is
# taken only from a tag signed by the key pinned at install, in release-keys/ beside the values: never from a key the
# checkout carries, which whoever forged a tag could change too.
set -euo pipefail
usage() {
  echo "Usage: twes install | start | update | policy (auto HH:MM-HH:MM | notify | off) | offsite (on | off) | tick | status | restore-commands | hold (on | off) | pin-key <file> | schedule" >&2
  exit 2
}
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
deploy=$root/scripts/deploy/deploy.sh
values=${TWES_VALUES:-$HOME/.twes-in/install.env}
state=$(dirname "$values")/state
records=$(dirname "$values")/releases
keys=$(dirname "$values")/release-keys
# The shop's time, which its window is read in; the backups keep UTC.
zone=${TWES_ZONE:-Africa/Tunis}
release_tags='v[0-9][0-9][0-9][0-9].[0-9][0-9].[0-9][0-9].*'

say() { printf '%s twes %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$state/twes.log"; }
refuse() { echo "twes: refused — $*" >&2; exit 1; }
value() { awk -v k="$1" 'index($0, k "=") == 1 { v = substr($0, length(k) + 2) } END { print v }' "$values"; }
now() { echo "${TWES_NOW:-$(date +%s)}"; }
# A state file's first line, or the default when it was never written.
recall() { if [[ -f "$state/$1" ]]; then head -n 1 "$state/$1"; else echo "${2:-}"; fi; }
# Whether a state file lists a line, exactly.
listed() { [[ -f "$state/$2" ]] && grep -qxF -e "$1" "$state/$2"; }
# A moment in the shop's time, HH:MM; GNU date and BSD date (macOS) each take the epoch their own way.
shop_time() {
  if date -d @0 +%s >/dev/null 2>&1; then TZ=$zone date -d "@$1" +%H:%M; else TZ=$zone date -r "$1" +%H:%M; fi
}
shop_day() {
  if date -d @0 +%s >/dev/null 2>&1; then TZ=$zone date -d "@$1" +%F; else TZ=$zone date -r "$1" +%F; fi
}

umask 077
# Install writes the values; every other command needs them.
if [[ "${1:-}" == install && ! -f "$values" ]]; then
  mkdir -p "$(dirname "$values")"; chmod 700 "$(dirname "$values")"
  bash "$root/scripts/deploy/new-instance.sh" --onprem "$values" >&2
fi
[[ -f "$values" ]] || refuse "no values at $values (twes install writes them; TWES_VALUES names another)"
[[ "$(value TWES_INSTALL)" == onprem ]] || refuse "$values are not a shop's (TWES_INSTALL=onprem)"
mkdir -p "$state"

# This machine's address on the shop's network, as a phone reaches it: the router may hand out another one any morning.
# Under WSL it is Windows', whose ports Docker Desktop publishes, never the Linux side's own. Without a network, only this
# computer opens the application, at https://localhost.
platform() {
  if [[ -n "${TWES_PLATFORM:-}" ]]; then echo "$TWES_PLATFORM"
  elif [[ "$(uname -s)" == Darwin ]]; then echo macos
  elif grep -qi microsoft /proc/version; then echo wsl
  else echo linux
  fi
}
# Started by systemd (-Engine Wsl), a process is not given Windows' PATH as a WSL session's are: powershell.exe is then
# looked for where Windows keeps it.
windows_powershell() {
  command -v powershell.exe 2>/dev/null && return 0
  local found=${TWES_POWERSHELL:-/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe}
  [[ -x "$found" ]] && echo "$found"
}
detect_address() {
  local ps
  case "$(platform)" in
    wsl)
      ps=$(windows_powershell) || return 3
      "$ps" -NoProfile -NonInteractive -Command \
        "(Get-NetIPConfiguration | Where-Object { \$_.IPv4DefaultGateway -ne \$null -and \$_.NetAdapter.Status -eq 'Up' } | Select-Object -First 1).IPv4Address.IPAddress" \
        | tr -d '\r' ;;
    macos) ipconfig getifaddr "$(route -n get default | awk '/interface:/ { print $2 }')" ;;
    *) ip -4 route get 1.1.1.1 | sed -n 's/.* src \([0-9.]*\).*/\1/p' ;;
  esac
}
lan_address() {
  local fixed found
  fixed=$(value LAN_HOST)
  if [[ -n "$fixed" ]]; then echo "$fixed"; return 0; fi
  # A machine with no route answers with an error, which is that case and no other: the fallback says so. A probe that
  # cannot run at all (3) says nothing of the network: the address last read is kept.
  local code=0
  found=$(set -o pipefail; detect_address 2>/dev/null | head -n 1) || code=$?
  if ((code == 3)) && [[ "$(recall lan-host)" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$(recall lan-host)" != 127.* ]]; then
    say "Windows' address could not be read (no powershell.exe): $(recall lan-host) kept" >&2
    recall lan-host
    return 0
  fi
  if [[ "$found" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$found" != 127.* ]]; then echo "$found"; else echo 127.0.0.1; fi
}

# Compose on the release running here, at the address it was started with.
compose() { LAN_HOST=$(cat "$state/lan-host") bash "$deploy" --compose "$values" "$@"; }

# What runs now: the last release deploy.sh started here, whichever way.
running() { if [[ -f "$records/history" ]]; then awk '$2 == "deployed" || $2 == "started" { r = $3 } END { print r }' "$records/history"; fi; }
# A commit's release tag; a commit at none (a checkout made by hand) is named by itself.
tag_of() { git -C "$root" describe --exact-match --tags --match "$release_tags" "$1" 2>/dev/null || echo "$1"; }

# --- Alerts ------------------------------------------------------------------------------------------------------------

# A parameter is a word and a value of one line with no tab: what a held-back alert is written down as.
check_params() {
  local p
  for p in "$@"; do [[ "$p" =~ ^[a-z_]+=[^$'\t\n']*$ ]] || refuse "an alert's parameter must be name=value on one line: $p"; done
}
urldecode() { local s=${1//+/ }; printf '%b' "${s//%/\\x}"; }

# Through the shop's own account (MAILER_DSN, smtp://user:password@host:port), STARTTLS required, or TLS from the start
# on 465. The account and its password reach curl through a netrc file, never its command line. A mail that does not
# leave (no internet that minute, a password revoked) is kept under state/pending-mails and sent by the next tick: the
# episode it tells of is already written down as told, so it would never be said again.
mail_alert() {
  local subject=$1 body=$2 to from held
  to=$(value ALERT_EMAIL) from=$(value MAILER_SENDER)
  if [[ -z "$(value MAILER_DSN)" || -z "$to" || -z "$from" ]]; then say "not mailed (MAILER_DSN, MAILER_SENDER and ALERT_EMAIL are needed): $subject"; return 0; fi
  mkdir -p "$state/pending-mails"
  held=$state/pending-mails/$(now)-$$-$RANDOM
  printf '%s\n' "$subject" > "$held.subject"
  {
    # A header is ASCII: the subject, accented, is written as RFC 2047 says.
    printf 'From: twes-in <%s>\r\nTo: %s\r\nSubject: =?UTF-8?B?%s?=\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Transfer-Encoding: 8bit\r\n\r\n' \
      "$from" "$to" "$(printf '%s' "$subject" | base64 | tr -d '\n')"
    printf '%s\n' "$body" | sed 's/$/\r/'
  } > "$held.eml"
  send_held_mail "$held"
}
# One kept mail sent, and forgotten once it left.
send_held_mail() {
  local held=$1 subject dsn to from auth hostport host port user pass url
  subject=$(head -n 1 "$held.subject")
  dsn=$(value MAILER_DSN) to=$(value ALERT_EMAIL) from=$(value MAILER_SENDER)
  [[ "$dsn" =~ ^smtps?://([^@]+)@([^/?]+) ]] || { say "not mailed: MAILER_DSN is not smtp://user:password@host:port"; return 0; }
  auth=${BASH_REMATCH[1]} hostport=${BASH_REMATCH[2]}
  user=$(urldecode "${auth%%:*}") pass=$(urldecode "${auth#*:}")
  host=${hostport%:*} port=${hostport##*:}
  [[ "$port" != "$hostport" ]] || port=587
  if [[ "$port" == 465 ]]; then url="smtps://$host:465"; else url="smtp://$host:$port"; fi
  printf 'machine %s login %s password %s\n' "$host" "$user" "$pass" > "$held.netrc"
  if curl -sS --max-time 60 --ssl-reqd --netrc-file "$held.netrc" --url "$url" --mail-from "$from" --mail-rcpt "$to" --upload-file "$held.eml"; then
    say "mailed to $to: $subject"
    rm -f "$held.eml" "$held.subject"
  else
    say "the mail to $to did not leave, kept for the next tick: $subject"
  fi
  rm -f "$held.netrc"
}
send_held_mails() {
  local held
  for held in "$state"/pending-mails/*.eml; do
    [[ -f "$held" ]] && send_held_mail "${held%.eml}"
  done
  return 0
}
held_mails() { local n=0 f; for f in "$state"/pending-mails/*.eml; do [[ -f "$f" ]] && n=$((n + 1)); done; echo "$n"; }

# Recorded in the application (app:installation:tell), or held back until it answers. A line it refuses exits 2
# (INVALID): it would be refused at every try, so it is said, with the application's reason, and never kept.
deliver() {
  local said code=0
  said=$(compose exec -T api bin/console app:installation:tell --no-interaction "$@" 2>&1) || code=$?
  if ((code == 2)); then say "the application refused $1: $(tr '\n' ' ' <<<"$said" | sed 's/ *$//')"; return 0; fi
  return "$code"
}
tell() {
  deliver "$@" && return 0
  (IFS=$'\t'; echo "$*") >> "$state/pending-alerts"
  say "held back until the application answers: $1"
}
deliver_held() {
  [[ -s "$state/pending-alerts" ]] || return 0
  local line kept=() fields
  while IFS= read -r line; do
    IFS=$'\t' read -ra fields <<<"$line"
    deliver "${fields[@]}" || kept+=("$line")
  done < "$state/pending-alerts"
  if ((${#kept[@]})); then printf '%s\n' "${kept[@]}" > "$state/pending-alerts"; else rm -f "$state/pending-alerts"; fi
}

# kind, the mail's subject, its body, then the parameters the application's notification carries.
alert() {
  local kind=$1 subject=$2 body=$3; shift 3
  check_params "$@"
  mail_alert "[twes-in $(hostname)] $subject" "$body"
  tell "$kind" "$@"
}

# --- Health ------------------------------------------------------------------------------------------------------------

# The deep health check through the edge, as the shop's browser reaches it, trusting the installation's own authority.
# Prints what fails when it fails; a release just started gets three minutes to settle.
deep_health() {
  local tries=${1:-1} code
  curl -fsS --max-time 10 -o "$state/root.crt" http://localhost/root.crt || { echo edge; return 1; }
  printf 'Authorization: Bearer %s\n' "$(value MONITOR_TOKEN)" > "$state/health.header"
  while :; do
    code=$(curl -sS --max-time 15 --cacert "$state/root.crt" -H "@$state/health.header" -o "$state/health.json" \
      -w '%{http_code}' https://localhost/api/health/deep) || code=000
    [[ "$code" == 200 ]] && return 0
    tries=$((tries - 1))
    ((tries > 0)) || break
    sleep "${TWES_HEALTH_PAUSE:-10}"
  done
  if [[ "$code" == 503 ]]; then sed -n 's/.*"failing":\[\([^]]*\)\].*/\1/p' "$state/health.json" | tr -d '"'; else echo "api ($code)"; fi
  return 1
}

# --- Commands ----------------------------------------------------------------------------------------------------------

# At logon Docker Desktop comes up after the session that runs this, with no way to be waited for but asking: its daemon
# is asked a bounded number of times. Where a service manager orders the two (After=docker.service), it answers at once.
docker_ready() {
  local tries=0 limit=${TWES_DOCKER_TRIES:-60}
  until docker info >/dev/null 2>&1; do
    tries=$((tries + 1))
    ((tries < limit)) || refuse "Docker did not answer after $limit tries: start Docker Desktop (or the docker service), then twes start"
    sleep "${TWES_DOCKER_PAUSE:-5}"
  done
  ((tries == 0)) || say "Docker answered after $tries tries"
}

# A command run on the pinned keys (gpg, git verify-tag). gpg puts its agent's sockets in the keys' folder where the
# system gives no /run/user, and a socket's path holds 107 bytes at most, so a shop folder deep enough made every import
# fail: the command is handed a short link to the folder instead, and the agent it started is stopped after.
keyring() {
  local link status=0
  link=$(mktemp -d /tmp/twes-gpg.XXXXXX)
  ln -s "$keys" "$link/k"
  GNUPGHOME=$link/k "$@" || status=$?
  GNUPGHOME=$link/k gpgconf --kill all
  rm -rf "$link"
  return "$status"
}

# The public key every release tag must be signed with; a file holding any secret key is refused, so none is ever kept.
pin_key() {
  local listing fingerprints
  [[ -f "$1" ]] || refuse "no key file at $1"
  listing=$(gpg --batch --with-colons --show-keys "$1" 2>/dev/null) || listing=''
  [[ "$listing" != *$'\n'sec:* && "$listing" != sec:* ]] || refuse "$1 holds a secret key: pin the public key alone (gpg --armor --export <key>)"
  fingerprints=$(awk -F: '$1 == "pub" { want = 1; next } want && $1 == "fpr" { print $10; want = 0 }' <<<"$listing")
  [[ -n "$fingerprints" ]] || refuse "$1 holds no public key"
  mkdir -p "$keys"; chmod 700 "$keys"
  keyring gpg --batch --quiet --import "$1" 2>/dev/null || refuse "gpg could not import $1"
  say "release key pinned: $(tr '\n' ' ' <<<"$fingerprints")— compare it with the developer's before trusting it"
}
# Why a release tag cannot be taken, or nothing when the pinned key verifies it.
# A tag the pinned key does not verify is written down and alerted: each time an update asks for it, and once from tick
# whatever the policy ("once"), so a forged tag is never met in silence. It answers 0 when the tag verifies.
verified() { # tag, the release running, once
  local why
  why=$(unsigned "$1")
  [[ -n "$why" ]] || return 0
  if [[ "${3:-}" == once ]] && listed "$1" refused-releases; then return 1; fi
  listed "$1" refused-releases || echo "$1" >> "$state/refused-releases"
  alert installation.update_refused "Mise à jour refusée : $1 n'est pas signée" \
    "La mise à jour vers $1 a été refusée : $why. Rien n'a été changé, ${2:-aucune version} tourne toujours. Une version que la clé de publication ne signe pas peut venir de quelqu'un d'autre que le développeur." \
    "version=$1"
  say "refused: $why"
  return 1
}
unsigned() {
  keyring gpg --batch --with-colons --list-keys 2>/dev/null | grep -q '^pub:' \
    || { echo "no release key is pinned here (twes pin-key <the developer's public key>)"; return 0; }
  keyring git -C "$root" verify-tag "$1" >/dev/null 2>&1 || echo "$1 is not signed by the release key pinned here"
}

# A question on the terminal; its answer on stdout. A secret is read without echo.
ask() { # prompt, secret
  local answer=''
  printf '%s ' "$1" >&2
  if [[ "${2:-}" == secret ]]; then IFS= read -rs answer || true; echo >&2; else IFS= read -r answer || true; fi
  printf '%s' "$answer"
}
address_asked() { # prompt
  local a; a=$(ask "$1")
  [[ "$a" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || refuse "not a mail address: $a"
  printf '%s' "$a"
}
urlencode() { local LC_ALL=C s=$1 out='' c i; for ((i = 0; i < ${#s}; i++)); do c=${s:i:1}; case "$c" in [A-Za-z0-9._~-]) out+=$c ;; *) printf -v c '%%%02X' "'$c"; out+=$c ;; esac; done; printf '%s' "$out"; }

install() {
  local sender password alert folder listing fingerprint email first second
  if [[ -z "$(value MAILER_DSN)" ]]; then
    sender=$(address_asked "The shop's Gmail address, which mails leave from:")
    password=$(ask "Its app password (Google Account > Security > App passwords):" secret)
    password=${password//[[:space:]]/}
    [[ -n "$password" ]] || refuse "no app password given"
    set_value MAILER_DSN "smtp://$(urlencode "$sender"):$(urlencode "$password")@smtp.gmail.com:587"
    set_value MAILER_SENDER "$sender"
  fi
  if [[ -z "$(value ALERT_EMAIL)" ]]; then
    alert=$(address_asked "Who is mailed when something goes wrong (the developer):")
    set_value ALERT_EMAIL "$alert"
    folder=$(ask "The backups' folder, on a second disk or a USB drive (blank: this disk):")
    if [[ -n "$folder" ]]; then
      [[ -d "$folder" && -w "$folder" ]] || refuse "no folder at $folder that this account may write: make it, then twes install again"
      set_value BACKUP_DIRECTORY "$folder"
      backup_folder_ready >/dev/null || refuse "the folder $folder cannot be named as the backups' folder"
    fi
  fi
  # Updates come by themselves inside a daily window (docs/SPEC.md § 7, 2026-10-20 01:43): proposed from the shop's
  # hours, the night when the computer stays on, else an hour after closing, and never across midnight. Asked by a
  # first install only: a policy set afterwards (twes policy notify) is the shop's, and an install run again keeps it.
  if [[ ! -s "$state/operator" && -z "$(value UPDATE_WINDOW)" ]]; then
    local night closing minutes proposed window
    night=$(ask "Does this computer stay on at night? (yes or no):")
    case "$night" in
      yes) proposed=02:00-05:00 ;;
      no)
        closing=$(ask "At what time does the shop close? (HH:MM, the shop's time):")
        [[ "$closing" =~ ^([01][0-9]|2[0-3]):([0-5][0-9])$ ]] || refuse "a time is HH:MM, such as 19:30"
        minutes=$(( (10#${BASH_REMATCH[1]} * 60 + 10#${BASH_REMATCH[2]} + 60) % 1440 ))
        (( minutes < 1380 )) || minutes=0
        proposed=$(printf '%02d:%02d-%02d:%02d' $((minutes / 60)) $((minutes % 60)) $(((minutes + 60) / 60)) $((minutes % 60))) ;;
      *) refuse "answer yes or no: does this computer stay on at night" ;;
    esac
    window=$(ask "Updates are applied by themselves each day inside a window, the shop's time [$proposed] (Enter to take it, or HH:MM-HH:MM):")
    policy auto "${window:-$proposed}"
  fi
  # Never a refusal (docs/START.md § 16): what the backups survive is said in words, and tick says it again each day.
  if [[ -z "$(value BACKUP_DIRECTORY)" ]]; then
    say "the backups stay on this computer's own disk: a dead disk loses every invoice with its backups; plug in a second disk or a USB drive and set BACKUP_DIRECTORY in $values to a folder on it, then twes start"
  fi
  if [[ "$(value BACKUP_OFFSITE)" != on ]]; then
    say "no copy leaves this computer: a stolen, burnt or encrypted computer loses every backup with it; give a bucket's values (BACKUP_S3_*) in $values, then twes offsite on: the folder is copied there every hour"
  fi
  if ! keyring gpg --batch --with-colons --list-keys 2>/dev/null | grep -q '^pub:'; then
    listing=$(gpg --batch --with-colons --show-keys "$root/infra/onprem/release-key.asc" 2>/dev/null) || listing=''
    fingerprint=$(awk -F: '$1 == "pub" { want = 1; next } want && $1 == "fpr" { print $10; exit }' <<<"$listing")
    [[ -n "$fingerprint" ]] || refuse "the checkout holds no release key at infra/onprem/release-key.asc"
    echo "The release key this checkout names: $(sed -E 's/(.{4})/\1 /g' <<<"$fingerprint")" >&2
    [[ "$(ask "Type yes if it is the fingerprint the developer gave you:")" == yes ]] \
      || refuse "the release key was not pinned: nothing is installed from a key no one confirmed"
    pin_key "$root/infra/onprem/release-key.asc"
  fi
  if [[ -z "$(running)" ]]; then update || refuse "the first install did not finish: read the lines above, then twes install again"; fi
  if [[ ! -s "$state/operator" ]]; then
    email=$(address_asked "The platform operator's mail address (the developer's sign-in):")
    first=$(ask "Their password:" secret); second=$(ask "Again:" secret)
    [[ "$first" == "$second" ]] || refuse "the two passwords differ: twes install again"
    printf '%s\n' "$first" | compose exec -T api bin/console app:seed --no-interaction "--operator-email=$email" \
      --operator-password-stdin --without-company >&2 || refuse "the application did not make the operator: read its answer above, then twes install again"
    echo "$email" > "$state/operator"
  fi
  case "$(platform)" in
    linux) schedule ;;
    wsl) docker_desktop || schedule ;;
    macos) say "twes start and twes tick are not scheduled on macOS yet: run twes start after each start of the computer, and twes tick every quarter hour (docs/START.md section 16)" ;;
  esac
  say "installed: $(tag_of "$(running)"), https://localhost on this computer; the operator is $(cat "$state/operator")"
}

# A path as a systemd unit reads it: quoted, a percent sign doubled, as systemd takes % for its specifiers. A double
# quote, a backslash or a line break would end or bend the quoting, so a path holding one is refused, never escaped.
unit_path() {
  [[ "$1" != *[\"\\$'\n']* ]] || refuse "$1 cannot be written in a systemd unit: install from a folder without a double quote, a backslash or a line break"
  printf '"%s"' "${1//%/%%}"
}
# Under Windows, Docker Desktop runs only in a signed-in session, so Windows' own tasks start twes there (install.ps1);
# Docker Engine inside Ubuntu is a systemd service, as on Linux. Asked of the daemon itself, never guessed.
docker_desktop() {
  local system
  system=$(docker info --format '{{.OperatingSystem}}') || refuse "Docker does not answer: start it, then run this again"
  [[ "$system" == *"Docker Desktop"* ]]
}
# Docker on Linux is a system service, so the units are the system's, run as this account, which Docker's group admits.
schedule() {
  local where units account bash_path script path_values action
  case "$(platform)" in
    linux) ;;
    wsl) ! docker_desktop || refuse "under Windows with Docker Desktop, scripts/onprem/install.ps1 schedules twes start and twes tick" ;;
    *) refuse "scheduling on $(platform) is not built: run twes start after each start of the computer, and twes tick every quarter hour" ;;
  esac
  where=${TWES_SYSTEMD_DIR:-/etc/systemd/system}
  # By number: systemd takes a UID for User=, and it survives a rename of the account.
  account=$(id -u)
  bash_path=$(command -v bash)
  script=$(unit_path "$root/scripts/onprem/twes")
  path_values=$(unit_path "TWES_VALUES=$(cd "$(dirname "$values")" && pwd)/$(basename "$values")")
  units=$(mktemp -d)
  for action in start tick; do
    {
      echo '[Unit]'
      if [[ $action == start ]]; then echo 'Description=twes-in: starts the installation at boot'
      else echo 'Description=twes-in: health, backups and updates'; fi
      echo 'Requires=docker.service'
      echo 'After=docker.service network-online.target'
      echo 'Wants=network-online.target'
      echo
      echo '[Service]'
      echo 'Type=oneshot'
      echo "User=$account"
      echo "Environment=$path_values"
      echo "ExecStart=$bash_path $script $action"
      # An update backs up first and waits for the release's health: as long as Windows' tasks are given.
      echo 'TimeoutStartSec=2h'
      if [[ $action == start ]]; then echo; echo '[Install]'; echo 'WantedBy=multi-user.target'; fi
    } > "$units/twes-in-$action.service"
  done
  # A tick still running when the next is due is left to finish: systemd starts no unit that is already active.
  printf '%s\n' '[Unit]' 'Description=twes-in: twes tick every quarter hour' '' '[Timer]' 'OnCalendar=*:0/15' 'Unit=twes-in-tick.service' \
    '' '[Install]' 'WantedBy=timers.target' > "$units/twes-in-tick.timer"
  as_root install -m 644 "$units/twes-in-start.service" "$units/twes-in-tick.service" "$units/twes-in-tick.timer" "$where/" \
    && as_root systemctl daemon-reload && as_root systemctl enable twes-in-start.service \
    && as_root systemctl enable --now twes-in-tick.timer \
    || { rm -rf "$units"; refuse "systemd did not take the units in $where: read its answer above"; }
  rm -rf "$units"
  say "scheduled: twes-in-start.service at boot, twes-in-tick.timer every quarter hour, as user $account"
}
as_root() { if [[ "$(id -u)" == 0 ]]; then "$@"; else sudo "$@"; fi; }

start() {
  local address why
  [[ -n "$(running)" ]] || refuse "nothing is deployed here yet: twes update installs the newest release"
  ! on_hold || refuse "$(hold_said): once the restore is done, twes hold off, then twes start"
  # The boot's start, tick's and a shortcut clicked twice would otherwise run compose over each other: one waits for the
  # other, which ends within Docker's tries and a compose up.
  exec 9> "$state/start.lock"
  flock -w "${TWES_START_WAIT:-900}" 9 || refuse "another twes start is running and has not ended: read $state/twes.log"
  docker_ready
  address=$(lan_address)
  [[ "$address" != 127.0.0.1 ]] || say "no network address found: only this computer opens https://localhost"
  echo "$address" > "$state/lan-host"
  why=$(backup_folder_ready) || backup_folder_missing "$why"
  resume_cut_update
  LAN_HOST=$address bash "$deploy" --again "$values"
  now > "$state/started-at"
  deliver_held
  say "running: https://localhost here, https://$address from the shop's network (a phone trusts http://$address/root.crt once)"
}

# A restore stops every container and outlasts a quarter hour: held, tick would otherwise start the installation again in
# its middle, on a database being restored, and the start at boot after a power cut too.
on_hold() { [[ -f "$state/hold" ]]; }
hold_said() { echo "held for a restore since $(shop_day "$(recall hold)") $(shop_time "$(recall hold)")"; }
hold() {
  case "$1" in
    on) now > "$state/hold"; say "held: tick and update act on nothing and twes start refuses until twes hold off" ;;
    off) rm -f "$state/hold"; say "hold ended: tick and update act again; twes start starts the installation" ;;
    *) usage ;;
  esac
}

# Each run reads no input: pasted as one block, docker compose run would take the lines after it as its own input. The
# lines after the checkout run the release gone back to, which may predate the hold: its file is removed by name.
restore_commands() { # label, commit, address
  local dc="LAN_HOST=$3 bash scripts/deploy/deploy.sh --compose $values"
  cat <<EOF
Nothing was deleted. To go back to the moment before the update, on the shop's computer, in $root:
  bash scripts/onprem/twes hold on
  git checkout --detach $2
  $dc stop
  $dc run --rm --no-deps restore gosu postgres pgbackrest --stanza=twes --spool-path=/tmp --set=$1 --type=immediate --target-action=promote --delta restore < /dev/null
  $dc run --rm --no-deps restore restic restore latest --tag before-update --host twes --include /files --target / < /dev/null
  rm -f $state/hold
  bash scripts/onprem/twes start
docs/RUNBOOK.md, « Restore a shop », gives each step and what to check after it.
EOF
}
# The same, for the last update made here, at any time after it: what the developer runs when the mail is not at hand.
restore_last() {
  local newest previous label
  [[ -s "$state/last-update" ]] || refuse "no update was made here, so there is no backup taken before one to go back to"
  read -r newest previous label < "$state/last-update"
  echo "The last update here was to $newest, from $(tag_of "$previous"), backed up before as $label."
  restore_commands "$label" "$previous" "$(recall lan-host 127.0.0.1)"
}

update() {
  local auto=${1:-} newest current previous='' label='' failure address why
  ! on_hold || refuse "$(hold_said): no update until twes hold off"
  exec 8> "$state/update.lock"
  flock -n 8 || { say "an update is already running"; return 0; }
  resume_cut_update held
  git -C "$root" fetch --quiet --tags origin || { say "the releases could not be read (no network?): nothing changed"; return 1; }
  newest=$(git -C "$root" tag --list "$release_tags" --sort=-v:refname | head -n 1)
  [[ -n "$newest" ]] || { say "no release published yet"; return 0; }
  previous=$(running)
  current=''
  [[ -z "$previous" ]] || current=$(tag_of "$previous")
  if [[ "$newest" == "$current" ]]; then say "up to date: $current"; return 0; fi
  if [[ -n "$auto" ]] && listed "$newest" failed-releases; then
    say "$newest failed here before: it is applied only by hand (twes update)"; return 0
  fi
  if [[ -n "$auto" ]] && listed "$newest" refused-releases; then
    say "$newest was refused here: it is applied only by hand (twes update), once its signature verifies"; return 0
  fi
  verified "$newest" "$current" || return 1
  address=$(recall lan-host)
  [[ -n "$address" ]] || address=$(lan_address)
  echo "$address" > "$state/lan-host"

  if [[ -n "$previous" ]]; then
    why=$(backup_folder_ready) || refuse "$why: no update without it, as an update backs up first"
    label=$(compose exec -T backup twes-backup before-update | sed -n 's/.*before-update: //p' | tail -n 1) || label=''
    if [[ ! "$label" =~ ^[0-9]{8}-[0-9]{6}F(_[0-9]{8}-[0-9]{6}[DI])?$ ]]; then
      alert installation.backup_failed "Mise à jour annulée : la sauvegarde d'avant n'a pas été faite" \
        "La sauvegarde prise avant la mise à jour vers $newest n'a pas abouti : rien n'a été changé, $current tourne toujours." \
        "version=$newest" "step=before-update"
      return 1
    fi
    printf '%s %s %s\n' "$newest" "$previous" "$label" > "$state/last-update"
    say "backed up before the update: $label"
  fi

  # Written before the checkout moves: an update cut short (the computer switched off, a task's time limit) leaves the
  # checkout on a release nothing answered for, and the next start or tick takes the shop back from what is written here.
  [[ -z "$previous" ]] || printf '%s %s %s\n' "$newest" "$previous" "$label" > "$state/update-in-progress"
  git -C "$root" checkout --quiet --detach "$newest"
  if LAN_HOST=$address bash "$deploy" --release "$values" && failure=$(deep_health 18); then
    rm -f "$state/update-in-progress"
    say "updated to $newest"
    if [[ -f "$state/failed-releases" ]]; then
      awk -v t="$newest" '$0 != t' "$state/failed-releases" > "$state/failed-releases.new"
      mv -f "$state/failed-releases.new" "$state/failed-releases"
    fi
    return 0
  fi
  failure=${failure:-the start}
  echo "$newest" >> "$state/failed-releases"
  if [[ -z "$previous" ]]; then
    alert installation.update_failed "Installation de $newest en échec" \
      "La première installation de $newest ne répond pas (en échec : $failure). Rien d'autre ne tournait sur cet ordinateur." \
      "version=$newest" "previous=-" "label=-"
    return 1
  fi
  say "$newest is unhealthy ($failure): starting $current again on the current schema"
  take_back "$newest" "$previous" "$label" "$address" "ne répondait pas (en échec : $failure)" annulée
  return 1
}

# The release the shop ran before an update, started again on the current schema, and everyone told: the update is
# written down as failed, so tick never applies it again by itself. Cleared once told, whatever the outcome.
take_back() { # newest, previous commit, label, address, what happened to the update, its word in the subject
  local current
  current=$(tag_of "$2")
  listed "$1" failed-releases || echo "$1" >> "$state/failed-releases"
  git -C "$root" checkout --quiet --detach "$2"
  if LAN_HOST=$4 bash "$deploy" --again "$values" && deep_health 18 >/dev/null; then
    alert installation.rolled_back "Mise à jour vers $1 $6, $current a repris" \
      "La mise à jour vers $1 $5. $current a été redémarré sur le schéma actuel et répond.
Sauvegarde prise avant la mise à jour : $3" \
      "version=$1" "previous=$current" "label=$3"
  else
    alert installation.update_failed "URGENT : mise à jour vers $1 $6, et le retour à $current en échec" \
      "La mise à jour vers $1 $5, et $current redémarré ne répond pas.
$(restore_commands "$3" "$2" "$4")" \
      "version=$1" "previous=$current" "label=$3"
  fi
  rm -f "$state/update-in-progress"
}

# An update cut short before its verdict: found by start, tick or a later update while no update runs (the lock held by
# the caller is named \`held\`), it takes the shop back to the release it ran, as an unhealthy update does.
resume_cut_update() { # [held]
  local newest previous label
  [[ -s "$state/update-in-progress" ]] || return 0
  if [[ "${1:-}" != held ]]; then
    exec 7> "$state/update.lock"
    flock -n 7 || { exec 7>&-; return 0; }
  fi
  read -r newest previous label < "$state/update-in-progress"
  say "the update to $newest was cut short: starting $(tag_of "$previous") again"
  take_back "$newest" "$previous" "$label" "$(recall lan-host 127.0.0.1)" "a été interrompue avant la fin (ordinateur éteint ou redémarré pendant qu'elle se faisait)" interrompue
  [[ "${1:-}" == held ]] || exec 7>&-
}

set_value() { # name value: the values file rewritten beside itself, readable by its owner alone
  # The pair reaches awk through its environment: -v would turn a backslash in the value (a folder's name) into an
  # escape, and a \n into a second line of the file.
  local tmp=$values.new.$$
  TWES_K=$1 TWES_V=$2 awk 'BEGIN { k = ENVIRON["TWES_K"]; v = ENVIRON["TWES_V"] }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next } { print } END { if (!done) print k "=" v }' \
    "$values" > "$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$values"
}

policy() {
  case "${1:-}" in
    auto)
      [[ "${2:-}" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || refuse "a window is HH:MM-HH:MM in the shop's time, such as 13:00-14:00"
      [[ "${2%-*}" < "${2#*-}" ]] || refuse "the window $2 ends before it starts"
      set_value UPDATE_POLICY auto; set_value UPDATE_WINDOW "$2"
      say "updates applied between ${2%-*} and ${2#*-}, $zone time" ;;
    notify | off)
      [[ $# -eq 1 ]] || usage
      set_value UPDATE_POLICY "$1"; set_value UPDATE_WINDOW ''
      say "update policy: $1" ;;
    *) usage ;;
  esac
}

offsite() {
  local name
  case "${1:-}" in
    on)
      for name in BACKUP_S3_ENDPOINT BACKUP_S3_BUCKET BACKUP_S3_REGION BACKUP_S3_KEY BACKUP_S3_SECRET; do
        [[ -n "$(value "$name")" ]] || refuse "$name is empty in $values: the bucket's values come first"
      done ;;
    off) ;;
    *) usage ;;
  esac
  set_value BACKUP_OFFSITE "$1"
  say "off-site copy $1"
  start
}

# What the backup service wrote down, as `<step> <line>`, one step a line; fails when the service does not answer.
backup_outcomes() {
  compose exec -T backup sh -c 'cd /var/lib/twes-backup/outcome || exit 0; for f in full diff copy verify offsite due; do [ -f "$f" ] && echo "$f $(cat "$f")"; done; true'
}
backup_stopped() { # why
  local day
  day=$(shop_day "$(now)")
  [[ "$(recall backup-stopped)" != "$day" ]] || return 0
  echo "$day" > "$state/backup-stopped"
  alert installation.backup_stopped "Les sauvegardes ne tournent plus" "$1" "step=due"
}

# The backups' folder on a second disk is named by an identity, written in it and in the values the first time it is
# there; a folder without it, or gone, is a drive unplugged (or another one), never a place to start backing up into.
# Prints why it is not ready; a blank folder (a Docker volume on this disk) is always there.
backup_folder_ready() {
  local folder id found=''
  folder=$(value BACKUP_DIRECTORY)
  [[ -n "$folder" ]] || return 0
  id=$(value BACKUP_FOLDER_ID)
  [[ -d "$folder" ]] || { echo "the backups' folder $folder is not there"; return 1; }
  [[ -f "$folder/twes-in-backups.id" ]] && read -r found < "$folder/twes-in-backups.id"
  if [[ -z "$id" ]]; then
    # The first time: an empty folder, or one an install from before the identity filled, is named now.
    if [[ -z "$found" ]]; then
      found=$(cat /proc/sys/kernel/random/uuid)
      echo "$found" > "$folder/twes-in-backups.id" || { echo "the backups' folder $folder cannot be written"; return 1; }
    fi
    set_value BACKUP_FOLDER_ID "$found"
    return 0
  fi
  [[ "$found" == "$id" ]] || { echo "the backups' folder $folder is not the backups' folder (no twes-in-backups.id naming $id)"; return 1; }
}
# Said at start and by tick, once a shop day: the application runs on, but nothing is backed up.
backup_folder_missing() { # why
  local day
  say "$1: plug its drive back in, then twes start; nothing is backed up until then"
  day=$(shop_day "$(now)")
  [[ "$(recall folder-told)" != "$day" ]] || return 0
  echo "$day" > "$state/folder-told"
  if [[ "$1" == *"not the backups' folder"* ]]; then
    mail_alert "[twes-in $(hostname)] Le dossier des sauvegardes n'est pas là" \
      "Le dossier $(value BACKUP_DIRECTORY) n'est pas celui des sauvegardes : rien n'y est sauvegardé. Rebranchez le disque des sauvegardes (ou vérifiez sa lettre ou son point de montage), puis lancez twes start. L'application tourne ; la base garde ses changements jusqu'au retour du disque."
  else
    mail_alert "[twes-in $(hostname)] Le dossier des sauvegardes n'est pas là" \
      "Le dossier $(value BACKUP_DIRECTORY) est absent : rien n'est sauvegardé. Rebranchez le disque des sauvegardes, puis lancez twes start. L'application tourne ; la base garde ses changements jusqu'au retour du disque."
  fi
}

# Where the backups are, as a person reads it.
backups_place() {
  local folder; folder=$(value BACKUP_DIRECTORY)
  if [[ -n "$folder" ]]; then echo "$folder"; else echo "this computer's own disk (Docker volume backup-local)"; fi
}

# While no copy leaves the computer, the developer is mailed once a shop day: a lost computer loses every backup with
# it. A mail and no notification, as the bucket is the developer's to give, not the shop's.
offsite_untold() {
  local day folder where
  [[ "$(value BACKUP_OFFSITE)" != on ]] || return 0
  day=$(shop_day "$(now)")
  [[ "$(recall offsite-told)" != "$day" ]] || return 0
  echo "$day" > "$state/offsite-told"
  folder=$(value BACKUP_DIRECTORY)
  if [[ -n "$folder" ]]; then where="sur $folder"; else where="sur le disque de cet ordinateur"; fi
  mail_alert "[twes-in $(hostname)] Aucune copie des sauvegardes hors de cet ordinateur" \
    "Les sauvegardes sont $where, et aucune copie ne quitte cet ordinateur : un ordinateur volé, brûlé ou chiffré par un rançongiciel les perd toutes avec les factures. Donnez les valeurs d'un bucket (BACKUP_S3_*) dans $values, puis lancez twes offsite on : le dossier y sera copié toutes les heures. Ce courrier revient chaque jour tant qu'aucune copie ne part."
}

tick() {
  local address failing line step t policy window newest current day outcomes why
  exec 8> "$state/update.lock"
  flock -n 8 || return 0
  [[ -f "$state/lan-host" ]] || { say "not started yet: twes start"; return 0; }
  if on_hold; then say "$(hold_said): nothing done until twes hold off"; return 0; fi
  resume_cut_update held
  address=$(lan_address)
  if [[ "$address" != "$(recall lan-host)" ]]; then
    say "the network address moved from $(recall lan-host) to $address"
    flock -u 8; start; flock -n 8 || return 0
  fi
  deliver_held
  send_held_mails

  # Unhealthy, the installation is started again once, as a container Docker left stopped comes back with compose up;
  # still unhealthy, the developer and the operators are told. Once per episode: a start that does not mend it is not
  # repeated every quarter hour, and a start just made is left its ten minutes to settle.
  if failing=$(deep_health 1); then
    rm -f "$state/unhealthy"
  elif [[ -f "$state/unhealthy" ]]; then
    :
  elif (($(now) - $(recall started-at 0) < 600)); then
    say "unhealthy ($failing) within ten minutes of a start: read again at the next tick"
  else
    echo "$failing" > "$state/unhealthy"
    say "unhealthy ($failing): starting the installation again"
    now >> "$state/self-restarts"
    if (start) && failing=$(deep_health 18); then
      rm -f "$state/unhealthy"
      say "healthy again once started again"
    else
      alert installation.unhealthy "L'installation ne va pas bien ($failing)" \
        "Le contrôle de santé de l'installation échoue : $failing. L'installation a été relancée et échoue encore. Il est relu toutes les quinze minutes ; une alerte nouvelle viendra s'il se remet puis échoue encore." \
        "check=$failing"
    fi
  fi

  # The schedule runs every half hour: silent for an hour and a half once the application has run for one, it stopped.
  if outcomes=$(backup_outcomes); then
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      step=${line%% *}
      if [[ "$step" == due ]]; then
        t=${line#due }
        t=${t%% *}
        if [[ "$t" =~ ^[0-9]+$ ]] && (($(now) - t > 5400 && $(now) - $(recall started-at "$(now)") > 3600)); then
          backup_stopped "Le calendrier des sauvegardes n'a pas tourné depuis plus d'une heure et demie alors que l'application tourne."
        fi
      elif [[ "$line" == *" failed "* ]] && ! listed "$line" backup-alerted; then
        echo "$line" >> "$state/backup-alerted"
        alert installation.backup_failed "Sauvegarde en échec : $step" "La sauvegarde « $step » a échoué : ${line#* }." "step=$step"
      fi
    done <<<"$outcomes"
  elif (($(now) - $(recall started-at "$(now)") > 3600)); then
    backup_stopped "Le service des sauvegardes ne répond pas alors que l'application tourne depuis plus d'une heure."
  fi

  why=$(backup_folder_ready) || backup_folder_missing "$why"
  offsite_untold

  policy=$(value UPDATE_POLICY)
  case "$policy" in
    off) return 0 ;;
    notify)
      git -C "$root" fetch --quiet --tags origin || return 0
      newest=$(git -C "$root" tag --list "$release_tags" --sort=-v:refname | head -n 1)
      current=$(tag_of "$(running)")
      if [[ -n "$newest" && "$newest" != "$current" ]] && verified "$newest" "$current" once && ! listed "$newest" notified; then
        echo "$newest" >> "$state/notified"
        tell installation.update_available "version=$newest" "previous=${current:--}"
        say "$newest is out; the owners are told"
      fi ;;
    auto)
      window=$(value UPDATE_WINDOW)
      [[ "$window" =~ ^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$ ]] || { say "UPDATE_POLICY=auto without a window: nothing applied (twes policy auto HH:MM-HH:MM)"; return 0; }
      t=$(shop_time "$(now)")
      [[ ! "$t" < "${window%-*}" && "$t" < "${window#*-}" ]] || return 0
      # Never at start: a computer switched on inside the window waits for the next tick past its first half hour.
      (($(now) - $(recall started-at "$(now)") >= 1800)) || return 0
      day=$(shop_day "$(now)")
      [[ "$(recall update-tried)" != "$day" ]] || return 0
      echo "$day" > "$state/update-tried"
      flock -u 8
      update --auto ;;
    *) say "UPDATE_POLICY=$policy: auto, notify or off" ;;
  esac
}

status() {
  local failing t
  echo "release:  $(tag_of "$(running)")"
  echo "address:  https://localhost, https://$(recall lan-host '(not started)')"
  echo "updates:  $(value UPDATE_POLICY) $(value UPDATE_WINDOW)"
  ! on_hold || echo "held:     $(hold_said | sed 's/^held //'): twes hold off once it is done"
  echo "backups to: $(backups_place)"
  if [[ "$(value BACKUP_OFFSITE)" == on ]]; then
    echo "off site: on, copied every hour"
  else
    echo "off site: off: a lost computer loses every backup; twes offsite on once a bucket's values are given"
  fi
  if failing=$(deep_health 1); then echo "health:   ok"; else echo "health:   failing ($failing)"; fi
  if [[ -s "$state/self-restarts" ]]; then
    t=$(tail -n 1 "$state/self-restarts")
    echo "          started again by tick: $(wc -l < "$state/self-restarts") time(s), last $(shop_day "$t") $(shop_time "$t")"
  fi
  echo "backups:"
  backup_outcomes | sed 's/^/  /' || echo "  (the backup service does not answer)"
  [[ ! -s "$state/pending-alerts" ]] || echo "held back: $(wc -l < "$state/pending-alerts") alert(s)"
  (($(held_mails) == 0)) || echo "held back: $(held_mails) mail(s)"
}

case "${1:-}" in
  start) [[ $# -eq 1 ]] || usage; start ;;
  update) [[ $# -eq 1 ]] || usage; update ;;
  policy) shift; policy "$@" ;;
  offsite) [[ $# -eq 2 ]] || usage; offsite "$2" ;;
  tick) [[ $# -eq 1 ]] || usage; tick ;;
  status) [[ $# -eq 1 ]] || usage; status ;;
  restore-commands) [[ $# -eq 1 ]] || usage; restore_last ;;
  hold) [[ $# -eq 2 ]] || usage; hold "$2" ;;
  pin-key) [[ $# -eq 2 ]] || usage; pin_key "$2" ;;
  install) [[ $# -eq 1 ]] || usage; install ;;
  schedule) [[ $# -eq 1 ]] || usage; schedule ;;
  *) usage ;;
esac
