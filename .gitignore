# ── Editors / OS ───────────────────────────────────────────────────────────────
/.idea
/.vscode
.DS_Store

# ── Claude Code local state ────────────────────────────────────────────────────
/.claude/settings.local.json
/.claude/worktrees
# Claude runtime state: var/claude/{handoff,reports,sleuth,inspections,gaps,forge,memory,logs}
# written by the PreCompact hook and the review skills. Throwaway by design — survives
# compaction inside a session, dies with the container, never committed.
/var
# Belt-and-braces: never commit a copy of ~/.claude or ~/.claude.json. Those hold the
# OAuth account, userID and machineID. scripts/claude-bootstrap/install.sh is one-directional
# (repo → ~/.claude) precisely so this directory is never created; the rule is here anyway.
/claude-bundle/
# Backups left by scripts/claude-bootstrap/apply-pending-settings.sh — never commit one.
/.claude/settings.json.bak.*
# NOT ignored, deliberately: scripts/claude-bootstrap/settings.json.pending — if one ever exists.
# It does not today: .claude/settings.json is tracked and was written DIRECTLY by Claude in this
# container (see CLAUDE.md Gotchas, 2026-07-29), so the relay was never needed. pdfturbo documents the
# file as classifier-blocked, and that may become true again without notice, which is why
# apply-pending-settings.sh is kept and this path stays un-ignored. Do not read this comment as
# saying the block is active.

# ── Reference clones — NEVER commit these ──────────────────────────────────────
# The upstream study clones (Invoice Ninja et al.) live in /tmp/xxx and are read-only
# references. This project is a clean-room reimplementation: upstream code must never
# enter this tree, because Invoice Ninja's backend and web UI are Elastic-License-2.0
# and copying them in would make this repo a derivative work. See
# docs/plans/reimplementation-strategy.plan.md § Licensing.
/reference/
/upstream/
/vendor-reference/

# ── PHP / Symfony ──────────────────────────────────────────────────────────────
# Paths are tier-qualified: the API lives in api/, so a root-anchored /vendor/ would match
# nothing. Both forms are kept — the root ones in case a tool is ever run from the repo root.
/vendor/
/api/vendor/
# api/var/ holds the PHPUnit cache and the php-cs-fixer cache. Note /var (Claude runtime state)
# above is a different directory and already ignored.
/api/var/
# (No /var/cache/ or /var/log/ entries: /var above already ignores that whole tree.)
.env.local
.env.*.local
.php-cs-fixer.cache
.phpunit.result.cache
phpstan.cache

# Standalone tool phars, fetched and SHA-256-verified by scripts/dev/fetch-tools.sh.
# Not committed: they are ~10 MB of third-party binary, and the script plus its pinned hashes is
# the reproducible record. Run that script after cloning, or `composer install` once Composer's
# dist URLs are reachable — see the script's header for why they currently are not.
/api/tools/bin/*.phar
/api/tools/bin/*.download

# ── Node / Angular ─────────────────────────────────────────────────────────────
node_modules/
/dist/
/.angular/
/coverage/
*.tsbuildinfo

# ── Flutter ────────────────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
/build/
*.iml

# ── Local QA / visual-evidence screenshots — never committed (binary, ad-hoc) ──
# NOTE: because these are gitignored AND the cloud container is reclaimed, a screenshot
# left here is evidence nobody will see — deliver it with SendUserFile in the same turn.
/qa-shots/

# ── Secrets ────────────────────────────────────────────────────────────────────
# Payment-gateway and e-invoicing credentials never belong in git. This list is deliberately broader than
# what exists today, because `git add`, `git commit` and `git push` are STANDING AUTONOMOUS operations here
# (CLAUDE.md § "Git autonomy") — so a credential file this list misses is one `git add -A` from being
# published. Certification round 5 checked each entry below with `git check-ignore` and found every one of
# them trackable.
*.pem
*.p12
*.pfx
*.key
*.jks
*.keystore
/config/jwt/

# Registry auth. `npm config set //registry.../:_authToken --location=project` writes this, and it is the one
# an ordinary npm workflow produces today.
.npmrc
*/.npmrc

# Symfony's own secrets vault. The decryption key is generated by its recipe in Wave 1 and is normally
# gitignored by that recipe; api/config/ was not covered by this block at all.
/api/config/secrets/**/*.decrypt.private.php
/api/config/secrets/**/*.key

# Apple signing material — App Store Connect keys and provisioning profiles.
*.p8
*.mobileprovision
*.cer
*.certSigningRequest

# Android signing. Flutter's own template already ignores mobile/android/key.properties; these are the files
# it does not cover.
*.aab
/mobile/android/app/upload-keystore.jks

# Service-account JSON (Google Play publishing, Firebase, cloud storage).
service-account*.json
gha-creds-*.json
