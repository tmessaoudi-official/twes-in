# ==============================================================================================================
# THE COMMITTED BASE OF THE STACK'S CONFIGURATION — the same cascade as `api/.env`, and for the same reason.
#
#     infra/.env         <- this file. COMMITTED. Safe defaults. Every secret is deliberately EMPTY.
#     infra/.env.local   <- gitignored. YOUR secrets. This is the only file you edit.
#
# This was `infra/.env.example` until 2026-08-02, which is a Laravel/Node convention and not a Symfony one. In
# Symfony the committed file IS the template: `symfony/dotenv` layers `.env.local` over `.env`, and Docker Compose
# does the same when both are passed with `--env-file` (the Makefile does that, adding `.env.local` only when it
# exists so a fresh clone still renders). A separate `.example` is a second copy that nothing reads and everything
# drifts from — and this repository has been bitten by exactly that shape often enough to have a CLAUDE.md section
# about it.
#
# EVERY SECRET BELOW IS EMPTY AND THAT IS THE POINT. `compose.yaml` uses `${VAR:?message}` for each, so an empty
# one stops the stack with a message naming it rather than starting with a guessable credential. A default password
# for the role that reads tenant data is a published credential, and "it was only the dev default" is how those
# reach production.
#
#     make env      # writes infra/.env.local with four freshly generated secrets. That is the whole setup.
# ==============================================================================================================

# --- Application ------------------------------------------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0

# openssl rand -hex 32
APP_SECRET=

# `SymfonyRuntime` is the default. FrankenPHP WORKER MODE would be switched on by setting this to
# `Runtime\FrankenPhpSymfony\Runtime`, and it is REFUSED by `scripts/gates/worker-mode-blocked.sh` — which reads
# every tracked file directly, because `compose-config.sh` renders with its own `--env-file` and cannot see a
# committed `.env` at all. That is why the text sweep is a separate gate: it also needs no Docker, so it cannot
# skip. Three
# preconditions are owed (see `api/Caddyfile`); the binding one is the client portal's own `random_bytes(32)`
# token, because `UuidV7` seeds per PROCESS and a worker's recoverable seed would span TENANTS. Gotchas
# 2026-08-05.
APP_RUNTIME=Symfony\Component\Runtime\SymfonyRuntime

DEFAULT_LOCALE=en

# --- HTTP -------------------------------------------------------------------------------------------------------
# `SERVER_NAME`, `HTTP_PORT` and `HTTPS_PORT` are FrankenPHP's and the API Platform distribution's own names, not
# invented ones. They were `TWES_SERVER_NAME` / `TWES_HTTP_PORT` until 2026-08-02; a project-specific prefix on a
# variable the upstream image already defines means the image's default silently does not apply.
#
# The public hostname. Licensing invariant 9 requires this to be CONFIGURATION and never hardcoded, so a public
# deployment is a config change rather than a code change. In production FrankenPHP obtains an ACME certificate
# for it, so it must actually resolve to this host. Locally, `:80` keeps it on plain HTTP — with a hostname it
# would attempt ACME against `localhost`, which fails in a way that reads like the container being broken.
SERVER_NAME=:80
HTTP_PORT=8080
HTTPS_PORT=8443
HTTP3_PORT=8443

# FrankenPHP is the only thing that can reach the application (the two-network split in compose.yaml enforces
# that), so `REMOTE_ADDR` is the correct trust setting: it means "trust the address the request actually arrived
# from". Never a wildcard — trusting an untrusted proxy lets any caller forge `X-Forwarded-For`, and therefore
# forge their own client IP in an audit log.
TRUSTED_PROXIES=REMOTE_ADDR

# Caddy and FrankenPHP extension seams, empty by default. See `api/Caddyfile` for what each one splices into.
CADDY_GLOBAL_OPTIONS=
CADDY_EXTRA_CONFIG=
CADDY_SERVER_EXTRA_DIRECTIVES=
FRANKENPHP_CONFIG=

# --- Database ---------------------------------------------------------------------------------------------------
# `POSTGRES_USER` rather than `POSTGRES_SUPERUSER`: that is the variable the official `postgres` image reads, and
# renaming it here meant compose had to map one onto the other — a translation step that is easy to get wrong and
# buys nothing.
POSTGRES_DB=twes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# THE ROLE SPLIT. Two roles, two passwords, and the split is the control rather than a convention:
# `FORCE ROW LEVEL SECURITY` stops a table's owner SKIPPING its policies, not REMOVING them — so the role the
# application connects as must never own a tenant table and must never be able to reach the role that does.
# The OWNER password is held ONLY by the one-shot `migrate` container; the API entrypoint REFUSES to start if it
# finds one.
TWES_DB_RUNTIME_ROLE=twes
TWES_DB_RUNTIME_PASSWORD=
TWES_DB_OWNER_ROLE=twes_owner
TWES_DB_OWNER_PASSWORD=

# --- Messenger and Lock -------------------------------------------------------------------------------------------
# DOCTRINE for the queue, VALKEY for the lock, and the split is deliberate — `api/config/packages/messenger.yaml`
# and `lock.yaml` each give the reasoning. Short version: Valkey runs with persistence OFF, which is right for a
# lock (a persisted lock resurrects one held by a dead process) and disqualifying for a queue.
#
# `auto_setup=false` is a SECURITY setting: auto-setup would `CREATE TABLE` on the runtime connection, making the
# restricted role the owner of a table — which `scripts/gates/schema-tenancy.php` refuses outright.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=false
LOCK_DSN=redis://valkey:6379

# --- Scale and limits ---------------------------------------------------------------------------------------------
# The API is stateless (no session, every operation marked stateless, tenancy bound per transaction), so it scales
# horizontally safely.
TWES_API_REPLICAS=2
TWES_WORKER_REPLICAS=2
# The SCHEDULER is deliberately absent from this list. It is pinned to ONE replica in compose.prod.yaml because two
# schedulers issue every recurring invoice twice — which in a billing product means charging a customer twice.

TWES_VERSION=dev
VALKEY_MAXMEMORY=256mb

# ==============================================================================================================
# DEVELOPMENT KNOBS. Every one is optional and every one has a working default, so this block is documentation
# rather than configuration — but an undocumented knob is an incomplete change, and a certification round found
# six of these reachable only by reading compose files.
#
# Override any of them in `infra/.env.local`, which is gitignored.
# ==============================================================================================================

# Which front-end bundle `make build-front` / `make build-front-dev` produce. The make targets set these; you only
# need them for a direct `docker compose` invocation. `development` keeps source maps (1.31 MB versus 189 kB) and
# `profile` keeps Dart source maps.
#NG_CONFIGURATION=production
#FLUTTER_BUILD_MODE=release

# Where the API serves each bundle. These MUST match the Caddyfile's `handle_path` prefixes — a mismatch is a blank
# page served with a 200 status, because the browser resolves the bundle's assets against the wrong root.
#NG_BASE_HREF=/admin/
#FLUTTER_BASE_HREF=/app/

# The uid/gid the dev container runs as. The Makefile passes your real `id -u`/`id -g`; these defaults exist only
# for a direct `docker compose build`. A mismatch against the owner of the bind-mounted `api/` tree means the
# container either cannot create `vendor/` or creates files you cannot edit.
#TWES_UID=1000
#TWES_GID=1000

# Xdebug. `make debug-on` / `make debug-off` set the mode; you do not normally set it here.
#XDEBUG_MODE=off
# THE TRIGGER SECRET, AND WORTH SETTING TO SOMETHING PRIVATE. With an empty value ANY `XDEBUG_TRIGGER` arms a debug
# session, so while `make debug-on` is in force any page you visit can open a debugger into the API container and
# `eval` arbitrary PHP there. `make debug-on` prints the value in force.
#TWES_XDEBUG_TRIGGER=twes-local-trigger
# 120s normally; `make debug-on` sets 0 so a held breakpoint is not killed mid-inspection.
#TWES_MAX_EXECUTION_TIME=120

# Published ports on 127.0.0.1. `DATABASE_PORT` collides with a PostgreSQL already running on the host, including
# the cluster the integration suite provisions — set 5433 to run both at once.
#HTTP_PORT=8080
# Production only. HTTP/3 is UDP and easy to forget — without the mapping, clients silently fall back to HTTP/2
# while the response still advertises QUIC.
#HTTPS_PORT=443
#HTTP3_PORT=443
#DATABASE_PORT=5432
#VALKEY_PORT=6379

# ==============================================================================================================
# PRODUCTION RESOURCE LIMITS, consumed by `compose.prod.yaml`. Conservative defaults; tune to the host.
# ==============================================================================================================
#DATABASE_MEMORY_LIMIT=2g
#VALKEY_MEMORY_LIMIT=512m
#GOTENBERG_MEMORY_LIMIT=1g
#TWES_API_MEMORY_LIMIT=512m
#TWES_WORKER_MEMORY_LIMIT=320m
#TWES_SCHEDULER_MEMORY_LIMIT=320m
#TWES_MIGRATE_MEMORY_LIMIT=320m
#TWES_API_REPLICAS=2
#TWES_WORKER_REPLICAS=2

# Assert that this database's dangerous capabilities really were revoked -- no TEMPORARY grant, no executable
# large-object functions. TRUE for the containerised stack, whose database init script performs the revocations;
# `api/.env` keeps it 0 for the local development and test databases, which deliberately grant TEMPORARY because
# the column-fidelity suite needs a scratch table. See api/.env for why this is not keyed on APP_ENV.
TWES_ASSERT_REVOKED_CAPABILITIES=1

# NOT AUTHENTICATION, and 0 for the containerised stack too -- deliberately, because this is the deployment a
# developer is most likely to expose. See api/.env for the full reasoning and the three independent controls.
TWES_TRUST_TENANT_HEADER=0
