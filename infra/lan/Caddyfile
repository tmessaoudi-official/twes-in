#
# The development stack's HTTPS door for a phone on the local network (docs/SPEC.md § 7, 2026-09-23 14:08). A phone
# cannot follow a link to http://localhost, and a page served over plain http to another device gets no camera, so
# `make up` detects this machine's address (LAN_HOST) and Caddy serves the web container there over TLS, with a
# certificate from its own local authority. The phone trusts it once: accept the warning, or install the root from
# http://LAN_HOST:8095/root.crt. Development only: nothing here is part of a deployment.
{
	admin off
	# A link's token is a password while it lives (64 hexadecimal characters in the path, the query, or the Referer a
	# page under it sends), and the error line of a failed upstream writes the whole request: every log line here has
	# each run of 32 or more written [token], as the web tier's access log does. Caddy leaves Cookie and Authorization
	# out by itself; X-Sentry-Auth carries the error tracker's key. The same block in every Caddy of the tree
	# (infra/edge/tests/token-free-logs.test.sh).
	log {
		format filter {
			request>uri regexp [0-9A-Fa-f]{32,} [token]
			request>headers>Referer regexp [0-9A-Fa-f]{32,} [token]
			request>headers>X-Sentry-Auth regexp [0-9A-Fa-f]{32,} [token]
		}
	}
	local_certs
	skip_install_trust
	# A phone connecting to an IP address sends no server name; this is the one it means.
	default_sni {$LAN_HOST}
	auto_https disable_redirects
	# The shop's edge's lifetimes (infra/onprem/Caddyfile): Caddy's own seven days, which a laptop may sleep through.
	pki {
		ca local {
			intermediate_lifetime 365d
		}
	}
}

https://{$LAN_HOST}:8443 {
	tls {
		issuer internal {
			# Twelve hours by Caddy's default: a laptop woken from sleep showed the phone a certificate warning until Caddy
			# next checked it. Renewed with a third left, a leaf of 30 days outlives any night or weekend asleep.
			lifetime 30d
		}
	}
	reverse_proxy web:80
}

# The local authority's root certificate, the one file a phone needs before it trusts the address above.
http://:8095 {
	@root path /root.crt
	handle @root {
		root * /data/caddy/pki/authorities/local
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	respond 404
}
