#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# twes-secrets <command> [argument...]: runs the command with the compose secrets mounted under /run/secrets read into
# its environment, each file as the variable its name says in capitals (pgbackrest_repo1_cipher_pass becomes
# PGBACKREST_REPO1_CIPHER_PASS), so a secret is never written in a container's environment, where `docker inspect` and
# `docker compose config` show it (docs/SPEC.md § 7, Docker secrets). The rules are the api's
# (api/src/Shared/Infrastructure/Secrets/ContainerSecrets.php): a file the environment already points at through
# <NAME>_FILE is left to its reader, an empty file or a name no variable can carry is refused, by its name, never its
# value; no directory reads nothing. The database image's entrypoint (compose.backup.yaml) and twes-backup run through
# it; centrifugo mounts it from the checkout (compose.prod.yaml). POSIX sh: centrifugo's image has busybox only.
set -eu

directory=${TWES_SECRETS_DIRECTORY:-/run/secrets}
if [ -d "$directory" ]; then
	for path in "$directory"/*; do
		[ -f "$path" ] || continue
		name=${path##*/}
		case "$name" in
			[a-z]*) ;;
			*) echo "twes-secrets: the secret $name has a name no variable can carry" >&2; exit 1 ;;
		esac
		case "$name" in
			*[!a-z0-9_]*) echo "twes-secrets: the secret $name has a name no variable can carry" >&2; exit 1 ;;
		esac
		variable=$(printf '%s' "$name" | tr 'a-z' 'A-Z')
		eval "pointer=\${${variable}_FILE:-}"
		[ -z "$pointer" ] || continue
		if [ ! -s "$path" ]; then
			echo "twes-secrets: the secret $name is empty: set $variable in the values file" >&2
			exit 1
		fi
		# The value as compose wrote it, byte for byte; the x keeps a trailing newline command substitution would drop.
		value=$(cat "$path"; printf x)
		export "$variable=${value%x}"
	done
fi
export TWES_SECRETS_READ=1
exec "$@"
