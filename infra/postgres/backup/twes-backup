#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# The backup service's one command (compose.backup.yaml), run by the schedule in crontab and by the restore drill
# (scripts/backup/restore-drill.sh), so what the drill proves is what runs every night:
#   twes-backup run           prepares the bucket, then hands over to the schedule
#   twes-backup init          the pgBackRest stanza and the restic repository, each made once and checked after
#   twes-backup full|diff     a base backup of the database (pgBackRest expires what is past retention after it)
#   twes-backup copy          the nightly pg_dump and the files volume into restic, then what is past 14 days pruned
#   twes-backup verify        both repositories read back whole
#   twes-backup restore-check the latest restored into a folder of its own, every table and index checked and every row
#                             read, then removed: a shop's monthly proof that its backups restore
#   twes-backup offsite       a shop's whole local folder copied off site, when compose.backup-offsite.yaml is on
#   twes-backup prune-offsite what is past 14 days pruned off site, run by the developer with a key the shop never holds
#   twes-backup before-update an incremental base backup, the dump and the files, and the base backup's label, which
#                             a restore to the moment before an update names (scripts/onprem/twes update)
#   twes-backup due           each step whose last success is older than its period: a shop's computer is off at night,
#                             so its schedule (BACKUP_SCHEDULE=due, compose.backup-local.yaml) asks every half hour
# pgBackRest runs as postgres, whose data it reads; restic runs as root, which can read the files the api wrote as
# its own user. Output goes to the container's log; a failure exits non-zero, which supercronic logs as such.
#
# Where MONITOR_URL is set (a deployment, docs/START.md § 15), each scheduled step tells the monitor how it ended, a
# heartbeat Gatus expects at its interval: base (full and diff), copy and verify. Without it (development, the drill)
# no heartbeat is sent; that is the setting, not a failure. A heartbeat the monitor does not take never fails the
# step: a monitor that hears nothing raises the alert for a missing heartbeat itself.
# Every scheduled step also writes down how it ended under OUTCOME_DIRECTORY, monitor or not: <step> the last outcome,
# <step>.ok the moment of its last success, which due reads and a shop's twes tick alerts on. One step runs at a time,
# so the copy taken before an update never meets a scheduled one in pgBackRest's own lock.
set -euo pipefail

STANZA=twes
DUMP_DIR=/var/lib/twes-backup/dump
FILES_DIR=/files
KEEP=14d
OUTCOME_DIRECTORY=${OUTCOME_DIRECTORY:-/var/lib/twes-backup/outcome}
CHECK_DIR=${CHECK_DIR:-/var/lib/twes-backup/restore-check}
CHECK_PORT=5499
BACKUP_LOCK=${BACKUP_LOCK:-/tmp/twes-backup.lock}

say() { printf '%s twes-backup %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
# An outcome written whole: twes tick, the schedule's `since` and the keeper read these files while a step writes them
# again, and a `>` empties a file before it writes it, so a read in between found nothing. Written beside it under a
# name no reader asks for, then renamed over it, which a reader sees all at once.
put() {
  local file="$OUTCOME_DIRECTORY/$1" part="$OUTCOME_DIRECTORY/.$1.$BASHPID"
  shift
  mkdir -p "$OUTCOME_DIRECTORY" && printf '%s\n' "$*" > "$part" && mv -f "$part" "$file" || { rm -f "$part"; return 1; }
}
pgbr() { gosu postgres pgbackrest --stanza="$STANZA" "$@"; }
# restic reaches the same bucket as pgBackRest under its own prefix; a bucket addressed by path (most S3-compatible
# services) or by host (AWS itself) is said once, in BACKUP_S3_URI_STYLE, for both.
rst() {
  local lookup=dns
  [[ "${BACKUP_S3_URI_STYLE:-host}" == path ]] && lookup=path
  restic -o "s3.bucket-lookup=$lookup" "$@"
}

# A repository made where none is found. restic says 10 for a repository that does not exist; any other failure (a
# bucket out of reach, a key refused, a wrong passphrase) is no missing repository, and one made then would start a
# second history beside the first, which the next restore would not find.
repository() {
  local what=$1 status=0
  shift
  rst "$@" cat config >/dev/null || status=$?
  case "$status" in
    0) ;;
    10) say "$what not found, making it"; rst "$@" init ;;
    *) say "$what could not be read (restic exited $status): nothing made, as a bucket out of reach, a key refused or a wrong passphrase is no missing repository"; return "$status" ;;
  esac
}

wait_for_database() {
  local tries=0
  until gosu postgres pg_isready -q -h /var/run/postgresql -U twes -d twes; do
    tries=$((tries + 1))
    ((tries < 60)) || { say "the database did not answer in 60 s"; return 1; }
    sleep 1
  done
}

init() {
  wait_for_database
  # A shop's folder is named by an identity its values carry (scripts/onprem/twes): a drive unplugged leaves an empty
  # folder in its place, and a stanza made there would take the archive onto the computer's own disk. Refused, the
  # archive waits in pg_wal until the drive is back, and every step fails, which twes tick says.
  if [[ -n "${BACKUP_FOLDER_ID:-}" ]]; then
    local found=''
    [[ -f "${BACKUP_FOLDER:-/backup}/twes-in-backups.id" ]] && read -r found < "${BACKUP_FOLDER:-/backup}/twes-in-backups.id"
    [[ "$found" == "$BACKUP_FOLDER_ID" ]] || { say "${BACKUP_FOLDER:-/backup} is not the backups' folder the values name ($BACKUP_FOLDER_ID): plug its drive back in"; return 1; }
  fi
  # A shop's folder (compose.backup-local.yaml) starts empty, or as a host path owned by whoever made it; pgBackRest
  # writes it as the server's own user, archiving included.
  if [[ "${PGBACKREST_REPO1_TYPE:-}" == posix ]]; then
    install -d -o postgres -g postgres -m 0750 "${PGBACKREST_REPO1_PATH:?a folder repository needs its path}"
  fi
  pgbr stanza-create
  repository "restic repository"
  pgbr check
  rst cat config >/dev/null
  say "ready: stanza $STANZA and the files repository"
}

base_backup() {
  pgbr --type="$1" backup
  say "$1 backup done"
}

# The storage keys of the files the dump names, read from the dump itself: its `file` table's rows, by the column named
# storage_key in the COPY line, wherever later migrations put it.
dump_keys() {
  gosu postgres pg_restore --data-only --table=file --file=- "$DUMP_DIR/twes.dump" | awk -F '\t' '
    !copying && /^COPY public\.file \(/ {
      columns = $0; sub(/^COPY public\.file \(/, "", columns); sub(/\) FROM stdin;$/, "", columns)
      n = split(columns, names, ", "); for (i = 1; i <= n; i++) if (names[i] == "storage_key") key = i
      copying = 1; next
    }
    copying && $0 == "\\." { exit }
    copying && key { print $key }'
}

# The dump and the files in one restic snapshot, from one point: a removal ends a file's row, then deletes its bytes, so
# a file the dump names may be gone by the time restic reads the files, and would come back named and missing. Every
# file the dump names is looked for in the snapshot; one missing was removed in between, and a dump taken again no
# longer names it. Removals are rare and quick, so three tries settle it; a fourth would mean files vanishing that no
# removal explains, which is said rather than copied over.
copy() {
  local tag=${1:-nightly} attempt snapshot named held missing=0
  wait_for_database
  for attempt in 1 2 3; do
    # Written beside, then moved: a dump cut short by a crash never replaces last night's whole one.
    gosu postgres pg_dump -h /var/run/postgresql -U twes -d twes --format=custom --file="$DUMP_DIR/twes.dump.part"
    gosu postgres mv "$DUMP_DIR/twes.dump.part" "$DUMP_DIR/twes.dump"
    snapshot=$(rst backup --json --tag "$tag" --host twes "$DUMP_DIR" "$FILES_DIR" | sed -n 's/^{"message_type":"summary".*"snapshot_id":"\([0-9a-f]*\)".*/\1/p')
    [[ -n "$snapshot" ]] || { say "restic named no snapshot for the copy"; return 1; }
    named=$(dump_keys | sort -u)
    held=$(rst ls --recursive "$snapshot" "$FILES_DIR" | sed -n "s#^$FILES_DIR/##p" | sort -u)
    missing=$(comm -23 <(printf '%s\n' "$named") <(printf '%s\n' "$held") | awk 'NF' | wc -l)
    ((missing > 0)) || break
    ((attempt == 3)) || say "$missing file the dump names was removed before the files were read: copied again"
  done
  ((missing == 0)) || { say "$missing file the dump names is still missing from the files after 3 copies"; return 1; }
  rst forget --host twes --keep-within "$KEEP" --prune
  say "dump and files copied ($tag), kept $KEEP"
}

# The local folder holds both repositories already encrypted; the off-site copy is one more restic repository, in the
# bucket, which a lost machine is restored from by copying the folder back first (docs/RUNBOOK.md, « Restore a lost
# shop machine »). The computer's key only adds: one that could prune could empty the bucket, and a computer taken over
# would take its off-site copies with it (docs/START.md § 16). The developer prunes, below.
offsite() {
  if [[ -z "${OFFSITE_REPOSITORY:-}" ]]; then
    say "off-site copy off (compose.backup-offsite.yaml is not in this installation)"
    return 0
  fi
  repository "off-site repository" -r "$OFFSITE_REPOSITORY"
  rst -r "$OFFSITE_REPOSITORY" backup --tag offsite --host twes /backup
  say "local folder copied off site"
}

# What is past fourteen days pruned off site, under the prune key, which the developer gives for this one run from a
# machine of their own (docs/RUNBOOK.md, « Prune a shop's off-site copy »), never the computer's.
prune_offsite() {
  [[ -n "${OFFSITE_REPOSITORY:-}" ]] || { say "OFFSITE_REPOSITORY: the off-site repository to prune, as the shop's compose.backup-offsite.yaml names it"; return 1; }
  [[ -n "${OFFSITE_PRUNE_KEY:-}" && -n "${OFFSITE_PRUNE_SECRET:-}" ]] || { say "OFFSITE_PRUNE_KEY and OFFSITE_PRUNE_SECRET: the bucket's prune key, which the shop never holds"; return 1; }
  [[ "$OFFSITE_PRUNE_KEY" != "${AWS_ACCESS_KEY_ID:-}" ]] || { say "OFFSITE_PRUNE_KEY is the computer's own key, which may only add: give the developer's prune key"; return 1; }
  # The computer's key cannot remove the lock each copy takes, which restic only warns of: those are stale once their
  # copy ended, and go first.
  AWS_ACCESS_KEY_ID=$OFFSITE_PRUNE_KEY AWS_SECRET_ACCESS_KEY=$OFFSITE_PRUNE_SECRET rst -r "$OFFSITE_REPOSITORY" unlock
  AWS_ACCESS_KEY_ID=$OFFSITE_PRUNE_KEY AWS_SECRET_ACCESS_KEY=$OFFSITE_PRUNE_SECRET \
    rst -r "$OFFSITE_REPOSITORY" forget --host twes --keep-within "$KEEP" --prune
  say "off site: kept $KEEP, the rest pruned"
}

# What an update is rolled back to when its own rollback is not enough. pgBackRest makes an incremental backup a full
# one when there is none yet; the label is read from its own account of the stanza, the last backup listed.
before_update() {
  pgbr --type=incr --annotation=reason=before-update backup
  local info label=''
  info=$(pgbr --output=json info)
  while [[ "$info" =~ \"label\":\"([^\"]*)\" ]]; do label=${BASH_REMATCH[1]}; info=${info#*"${BASH_REMATCH[0]}"}; done
  [[ -n "$label" ]] || { say "pgBackRest names no backup after the one just made"; return 1; }
  copy before-update
  say "before-update: $label"
}

verify() {
  pgbr verify
  rst check
  say "both repositories read back whole"
}

# The month's restore check, what verify cannot prove: that the backups give a database back. The latest is restored
# into a folder of its own, never the server's, and started with archiving off: promoted, it begins a timeline of its
# own, which must never reach the repository the next restore reads. Once it has left recovery, pg_amcheck checks every
# table and index and pg_dump reads every row; the server is then stopped and the folder removed, whatever happened
# (main's exit trap). The application's data check, which needs the api, is not run on it here.
restore_check() {
  put restore-check-tried.ok "$(date +%s)"
  check_down
  wait_for_database
  # The restore takes about the cluster's size, and the WAL it replays some more: a quarter's room above it.
  local size room need
  size=$(gosu postgres psql -h /var/run/postgresql -U twes -d twes -tAc 'SELECT sum(pg_database_size(datname)) FROM pg_database')
  [[ "$size" =~ ^[0-9]+$ ]] || { say "the database named no size ($size): the restore check not run"; return 1; }
  room=$(df --output=avail -B1 "$(dirname "$CHECK_DIR")" | tail -n 1 | tr -d ' ')
  need=$((size * 5 / 4))
  ((room >= need)) || { say "the restore check needs $need bytes beside $CHECK_DIR, $room are free: not run"; return 1; }
  # The socket's folder too: the server makes its lock file there and does not make the folder.
  install -d -o postgres -g postgres -m 0700 "$CHECK_DIR" "$CHECK_DIR.socket"
  pgbr --pg1-path="$CHECK_DIR" --archive-mode=off --spool-path=/tmp restore
  # Its log is said when it does not start, as the folder holding it goes with the check.
  gosu postgres pg_ctl -D "$CHECK_DIR" -l "$CHECK_DIR.log" -w -t 3600 \
    -o "-c archive_mode=off -c listen_addresses= -c port=$CHECK_PORT -c unix_socket_directories=$CHECK_DIR.socket" start \
    || { tail -n 20 "$CHECK_DIR.log"; say "the restored database did not start"; return 1; }
  # A server answers while it still replays towards the latest: what it holds is read once it has promoted. The step's
  # own time limit ends a replay that never does.
  until [[ "$(gosu postgres psql -h "$CHECK_DIR.socket" -p "$CHECK_PORT" -U twes -d twes -tAc 'SELECT pg_is_in_recovery()')" == f ]]; do sleep 1; done
  gosu postgres pg_amcheck -h "$CHECK_DIR.socket" -p "$CHECK_PORT" -U twes --all --heapallindexed --install-missing
  gosu postgres pg_dump -h "$CHECK_DIR.socket" -p "$CHECK_PORT" -U twes -d twes --format=custom --no-sync --file=/dev/null
  say "the latest backup restored, every table and index checked, every row read"
}

# The check's server stopped and its folder removed: after a check, and before one, as a check stopped at its time
# limit and killed a minute later leaves both behind.
check_down() {
  if [[ -f "$CHECK_DIR/postmaster.pid" ]]; then
    gosu postgres pg_ctl -D "$CHECK_DIR" -m fast -w stop || say "the restore check's server was not running: its folder removed"
  fi
  rm -rf "$CHECK_DIR" "$CHECK_DIR.log" "$CHECK_DIR.socket"
}

# The step's heartbeat, whichever way it ended: sent from the exit trap, so the step runs under `set -e` unchanged and
# a failure is reported with the status it exited on.
heartbeat() { # endpoint step [status, when the trap ran something after the step]
  local status=${3:-$?} endpoint=$1 success=true reason=''
  ((status == 0)) || { success=false; reason="$2 exited $status"; }
  # The step's own status is what it exits with: an outcome that cannot be written is said, and due runs the step again.
  if if ((status == 0)); then
    put "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ) ok" && put "$2.ok" "$(date +%s)"
  else
    put "$2" "$(date -u +%Y-%m-%dT%H:%M:%SZ) failed $reason"
  fi; then :; else say "the outcome of $2 could not be written under $OUTCOME_DIRECTORY"; fi
  # A step a server never schedules (endpoint -) has no line on the monitor to tell.
  if [[ -n "${MONITOR_URL:-}" && "$endpoint" != - ]]; then
    curl -fsS --max-time 15 -o /dev/null -X POST -H "Authorization: Bearer ${MONITOR_HEARTBEAT_TOKEN:?set MONITOR_HEARTBEAT_TOKEN with MONITOR_URL}" \
      --data-urlencode "success=$success" --data-urlencode "error=$reason" -G \
      "$MONITOR_URL/api/v1/endpoints/Sauvegardes_$endpoint/external" \
      || say "the monitor did not take the $endpoint heartbeat"
  fi
  exit "$status"
}

# How long ago a step last succeeded, in seconds; never is longer than any period. A success dated after now was written
# by a clock that ran ahead and has been set right since: read as never, or every step would wait for the clock to
# catch up with it, weeks without a backup.
since() {
  local t='' now
  [[ -f "$OUTCOME_DIRECTORY/$1.ok" ]] && read -r t < "$OUTCOME_DIRECTORY/$1.ok"
  now=$(date +%s)
  [[ "$t" =~ ^[0-9]+$ ]] && ((t <= now)) || { echo 999999999; return 0; }
  echo $((now - t))
}

# Each step in its own process, as the schedule runs it, so it writes its outcome and takes the lock itself. A failed
# step leaves the others to run: a base backup that fails is no reason to skip the night's copy.
due() {
  # The off-site copy's period: what a lost computer loses (docs/START.md § 16). Fifty minutes, since the schedule runs
  # every half hour and an hour's period read a second early would wait the next half hour.
  local failed=0 day=$((20 * 3600)) week=$((7 * 86400)) month=$((30 * 86400)) every=${OFFSITE_EVERY:-3000} keeper
  [[ "$every" =~ ^[0-9]+$ ]] || { say "OFFSITE_EVERY=$every: a number of seconds"; return 1; }
  # That the schedule is alive, whatever ran: a shop's twes tick alerts when this goes quiet while the application runs.
  # While a step runs (the first off-site copy may take hours) it says so every five minutes, naming the step; each step
  # ends within its time, so a step that hangs is a failed step, never a schedule gone quiet.
  put due "$(date +%s) ran"
  put due.step ''
  # The keeper's sleep goes with it: a sleep left behind would hold the schedule's output open, and supercronic would
  # wait on it.
  (
    nap=''
    trap '[[ -z "$nap" ]] || kill "$nap"; exit 0' TERM
    while :; do
      sleep "${DUE_BEAT:-300}" &
      nap=$!
      wait "$nap"
      put due "$(date +%s) running $(cat "$OUTCOME_DIRECTORY/due.step")"
    done
  ) &
  keeper=$!
  if (($(since full) >= week)); then
    due_step full || failed=1
  elif (($(since full) >= day && $(since diff) >= day)); then
    due_step diff || failed=1
  fi
  (($(since copy) < day)) || due_step copy || failed=1
  if [[ -n "${OFFSITE_REPOSITORY:-}" ]] && (($(since offsite) >= every)); then due_step offsite || failed=1; fi
  (($(since verify) < week)) || due_step verify || failed=1
  # Keyed on the last try as well as the last success: a check that fails runs again the next day, not every half hour.
  if (($(since restore-check) >= month && $(since restore-check-tried) >= day)); then due_step restore-check || failed=1; fi
  kill "$keeper"
  wait "$keeper" || true # the keeper ends on the signal just sent; its status says only that
  put due "$(date +%s) ran"
  ((failed == 0)) || { say "due: a step failed, written down under $OUTCOME_DIRECTORY"; return 1; }
}

# One step of the schedule in its own process, named for the keeper.
due_step() {
  put due.step "$1"
  bash "${BASH_SOURCE[0]}" "$1"
}

# How long a step may take, waiting for the lock included: what a shop's machine needs on a slow disk, with room. The
# off-site copy's is longer: its first one sends the whole folder over the shop's upload, and restic picks up what an
# interrupted one sent.
limit_of() {
  case "$1" in
    offsite) echo "BACKUP_OFFSITE_LIMIT ${BACKUP_OFFSITE_LIMIT:-43200}" ;;
    *) echo "BACKUP_STEP_LIMIT ${BACKUP_STEP_LIMIT:-14400}" ;;
  esac
}

# The step run again under its time limit. A step past it is stopped (its tools are sent TERM, then KILL a minute
# later) and written down as failed, saying so, whatever the step's own exit trap managed to write.
bounded() {
  local name limit status
  read -r name limit <<<"$(limit_of "$1")"
  [[ "$limit" =~ ^[0-9]+$ ]] || { say "$name=$limit: a number of seconds"; exit 1; }
  status=0
  TWES_BACKUP_BOUNDED=1 timeout --kill-after=60 "$limit" bash "${BASH_SOURCE[0]}" "$1" || status=$?
  if ((status == 124 || status == 137)); then
    say "$1 stopped after its time limit of $limit s ($name)"
    put "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ) failed $1 stopped after its time limit of $limit s"
    status=124
  fi
  exit "$status"
}

hold() { exec 9> "$BACKUP_LOCK"; flock 9; }

main() {
  case "${1:-}" in
    run)
      local schedule
      case "${BACKUP_SCHEDULE:-nightly}" in
        nightly) schedule=/etc/twes-backup/crontab ;;
        due) schedule=/etc/twes-backup/crontab.due ;;
        *) echo "BACKUP_SCHEDULE=$BACKUP_SCHEDULE: nightly or due, nothing else" >&2; exit 1 ;;
      esac
      # Under the steps' lock, as a step started while the service starts (a drill's, an update's) would otherwise find
      # restic's repository locked by this one; in a subshell, so the schedule does not inherit the lock held.
      (hold; init)
      exec supercronic -passthrough-logs "$schedule" ;;
    init) hold; init ;;
    # Every step bounded, the lock's wait included; once bounded, the step itself, which a stop sent at its limit ends as
    # a failure: left to bash, the exit trap would read the status 0 and write the step down, and tell the monitor, as
    # done, and the schedule would not run it again for a day.
    full|diff|copy|verify|restore-check|offsite|before-update)
      if [[ -n "${TWES_BACKUP_BOUNDED:-}" ]]; then trap 'exit 143' TERM; else bounded "$1"; fi ;;&
    # Each name is the step's line on the public status page (infra/monitor/gatus.yaml), unaccented: Gatus takes no
    # heartbeat for a name with an accent.
    full|diff) hold; trap "heartbeat Base $1" EXIT; base_backup "$1" ;;
    copy) hold; trap 'heartbeat Copie copy' EXIT; copy ;;
    verify) hold; trap 'heartbeat Relecture verify' EXIT; verify ;;
    # Its server stopped first, whichever way it ended; the heartbeat then reads the check's own status.
    restore-check) hold; trap 'ended=$?; check_down; heartbeat - restore-check "$ended"' EXIT; restore_check ;;
    # Off, the step never ran: a monitor that never expects it hears nothing.
    offsite) hold; [[ -z "${OFFSITE_REPOSITORY:-}" ]] || trap 'heartbeat Hors_site offsite' EXIT; offsite ;;
    before-update) hold; before_update ;;
    prune-offsite) hold; prune_offsite ;;
    due) due ;;
    # Which compose secrets this container read, by the variable each became: their values are never said.
    secrets)
      local path variable
      for path in "${TWES_SECRETS_DIRECTORY:-/run/secrets}"/*; do
        [[ -f "$path" ]] || continue
        variable=$(basename "$path" | tr 'a-z' 'A-Z')
        if [[ -n "${!variable:-}" ]]; then echo "secrets read: $variable"; else echo "secret not read: $variable"; fi
      done ;;
    *) echo "usage: twes-backup run|init|full|diff|copy|verify|restore-check|offsite|prune-offsite|before-update|due|secrets" >&2; exit 64 ;;
  esac
}

# Sourced by its test (scripts/tests/backup-heartbeat.test.sh), it only defines its functions. Started by
# `docker compose exec`, which skips the entrypoint, it first reads the compose secrets (infra/postgres/twes-secrets).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  [[ -n "${TWES_SECRETS_READ:-}" || ! -d "${TWES_SECRETS_DIRECTORY:-/run/secrets}" ]] || exec twes-secrets "$0" "$@"
  main "$@"
fi
