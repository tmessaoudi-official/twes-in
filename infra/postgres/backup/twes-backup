#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# The backup service's one command (compose.backup.yaml), run by the schedule in crontab and by the restore drill
# (scripts/backup/restore-drill.sh), so what the drill proves is what runs every night:
#   twes-backup run           prepares the bucket, then hands over to the schedule
#   twes-backup init          the pgBackRest stanza and the restic repository, each made once and checked after
#   twes-backup full|diff     a base backup of the database (pgBackRest expires what is past retention after it)
#   twes-backup copy          the nightly pg_dump and the files volume into restic, then what is past 14 days pruned
#   twes-backup verify        both repositories read back whole
#   twes-backup offsite       a shop's whole local folder copied off site, when compose.backup-offsite.yaml is on
#   twes-backup before-update an incremental base backup, the dump and the files, and the base backup's label, which
#                             a restore to the moment before an update names (scripts/onprem/twes update)
# pgBackRest runs as postgres, whose data it reads; restic runs as root, which can read the files the api wrote as
# its own user. Output goes to the container's log; a failure exits non-zero, which supercronic logs as such.
#
# Where MONITOR_URL is set (a deployment, docs/START.md § 15), each scheduled step tells the monitor how it ended, a
# heartbeat Gatus expects at its interval: base (full and diff), copy and verify. Without it (development, the drill)
# no heartbeat is sent; that is the setting, not a failure. A heartbeat the monitor does not take never fails the
# step: a monitor that hears nothing raises the alert for a missing heartbeat itself.
set -euo pipefail

STANZA=twes
DUMP_DIR=/var/lib/twes-backup/dump
FILES_DIR=/files
KEEP=14d

say() { printf '%s twes-backup %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
pgbr() { gosu postgres pgbackrest --stanza="$STANZA" "$@"; }
# restic reaches the same bucket as pgBackRest under its own prefix; a bucket addressed by path (most S3-compatible
# services) or by host (AWS itself) is said once, in BACKUP_S3_URI_STYLE, for both.
rst() {
  local lookup=dns
  [[ "${BACKUP_S3_URI_STYLE:-host}" == path ]] && lookup=path
  restic -o "s3.bucket-lookup=$lookup" "$@"
}

wait_for_database() {
  local tries=0
  until gosu postgres pg_isready -q -h /var/run/postgresql -U twes -d twes; do
    tries=$((tries + 1))
    ((tries < 60)) || { say "the database did not answer in 60 s"; return 1; }
    sleep 1
  done
}

init() {
  wait_for_database
  # A shop's folder (compose.backup-local.yaml) starts empty, or as a host path owned by whoever made it; pgBackRest
  # writes it as the server's own user, archiving included.
  if [[ "${PGBACKREST_REPO1_TYPE:-}" == posix ]]; then
    install -d -o postgres -g postgres -m 0750 "${PGBACKREST_REPO1_PATH:?a folder repository needs its path}"
  fi
  pgbr stanza-create
  # `cat config` reads the repository's own header: absent means never made, any other failure is a real one.
  if ! rst cat config >/dev/null 2>&1; then
    say "restic repository not found, making it"
    rst init
  fi
  pgbr check
  rst cat config >/dev/null
  say "ready: stanza $STANZA and the files repository"
}

base_backup() {
  pgbr --type="$1" backup
  say "$1 backup done"
}

copy() {
  local tag=${1:-nightly}
  wait_for_database
  # Written beside, then moved: a dump cut short by a crash never replaces last night's whole one.
  gosu postgres pg_dump -h /var/run/postgresql -U twes -d twes --format=custom --file="$DUMP_DIR/twes.dump.part"
  gosu postgres mv "$DUMP_DIR/twes.dump.part" "$DUMP_DIR/twes.dump"
  rst backup --tag "$tag" --host twes "$DUMP_DIR" "$FILES_DIR"
  rst forget --host twes --keep-within "$KEEP" --prune
  say "dump and files copied ($tag), kept $KEEP"
}

# The local folder holds both repositories already encrypted; the off-site copy is one more restic repository, in the
# bucket, which a lost machine is restored from by copying the folder back first (docs/RUNBOOK.md).
offsite() {
  if [[ -z "${OFFSITE_REPOSITORY:-}" ]]; then
    say "off-site copy off (compose.backup-offsite.yaml is not in this installation)"
    return 0
  fi
  if ! rst -r "$OFFSITE_REPOSITORY" cat config >/dev/null 2>&1; then
    say "off-site repository not found, making it"
    rst -r "$OFFSITE_REPOSITORY" init
  fi
  rst -r "$OFFSITE_REPOSITORY" backup --tag offsite --host twes /backup
  rst -r "$OFFSITE_REPOSITORY" forget --host twes --keep-within "$KEEP" --prune
  say "local folder copied off site, kept $KEEP"
}

# What an update is rolled back to when its own rollback is not enough. pgBackRest makes an incremental backup a full
# one when there is none yet; the label is read from its own account of the stanza, the last backup listed.
before_update() {
  pgbr --type=incr --annotation=reason=before-update backup
  local info label=''
  info=$(pgbr --output=json info)
  while [[ "$info" =~ \"label\":\"([^\"]*)\" ]]; do label=${BASH_REMATCH[1]}; info=${info#*"${BASH_REMATCH[0]}"}; done
  [[ -n "$label" ]] || { say "pgBackRest names no backup after the one just made"; return 1; }
  copy before-update
  say "before-update: $label"
}

verify() {
  pgbr verify
  rst check
  say "both repositories read back whole"
}

# The step's heartbeat, whichever way it ended: sent from the exit trap, so the step runs under `set -e` unchanged and
# a failure is reported with the status it exited on.
heartbeat() {
  local status=$? endpoint=$1 success=true reason=''
  ((status == 0)) || { success=false; reason="$2 exited $status"; }
  if [[ -n "${MONITOR_URL:-}" ]]; then
    curl -fsS --max-time 15 -o /dev/null -X POST -H "Authorization: Bearer ${MONITOR_HEARTBEAT_TOKEN:?set MONITOR_HEARTBEAT_TOKEN with MONITOR_URL}" \
      --data-urlencode "success=$success" --data-urlencode "error=$reason" -G \
      "$MONITOR_URL/api/v1/endpoints/Sauvegardes_$endpoint/external" \
      || say "the monitor did not take the $endpoint heartbeat"
  fi
  exit "$status"
}

main() {
  case "${1:-}" in
    run) init; exec supercronic -passthrough-logs /etc/twes-backup/crontab ;;
    init) init ;;
    # Each name is the step's line on the public status page (infra/monitor/gatus.yaml), unaccented: Gatus takes no
    # heartbeat for a name with an accent.
    full|diff) trap "heartbeat Base $1" EXIT; base_backup "$1" ;;
    copy) trap 'heartbeat Copie copy' EXIT; copy ;;
    verify) trap 'heartbeat Relecture verify' EXIT; verify ;;
    # Off, the step never ran: a monitor that never expects it hears nothing.
    offsite) [[ -z "${OFFSITE_REPOSITORY:-}" ]] || trap 'heartbeat Hors_site offsite' EXIT; offsite ;;
    before-update) before_update ;;
    *) echo "usage: twes-backup run|init|full|diff|copy|verify|offsite|before-update" >&2; exit 64 ;;
  esac
}

# Sourced by its test (scripts/backup/tests/heartbeat.test.sh), it only defines its functions.
[[ "${BASH_SOURCE[0]}" != "$0" ]] || main "$@"
