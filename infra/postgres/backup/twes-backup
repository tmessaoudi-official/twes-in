#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# The backup service's one command (compose.backup.yaml), run by the schedule in crontab and by the restore drill
# (scripts/backup/restore-drill.sh), so what the drill proves is what runs every night:
#   twes-backup run           prepares the bucket, then hands over to the schedule
#   twes-backup init          the pgBackRest stanza and the restic repository, each made once and checked after
#   twes-backup full|diff     a base backup of the database (pgBackRest expires what is past retention after it)
#   twes-backup copy          the nightly pg_dump and the files volume into restic, then what is past 14 days pruned
#   twes-backup verify        both repositories read back whole
#   twes-backup offsite       a shop's whole local folder copied off site, when compose.backup-offsite.yaml is on
#   twes-backup before-update an incremental base backup, the dump and the files, and the base backup's label, which
#                             a restore to the moment before an update names (scripts/onprem/twes update)
#   twes-backup due           each step whose last success is older than its period: a shop's computer is off at night,
#                             so its schedule (BACKUP_SCHEDULE=due, compose.backup-local.yaml) asks every half hour
# pgBackRest runs as postgres, whose data it reads; restic runs as root, which can read the files the api wrote as
# its own user. Output goes to the container's log; a failure exits non-zero, which supercronic logs as such.
#
# Where MONITOR_URL is set (a deployment, docs/START.md § 15), each scheduled step tells the monitor how it ended, a
# heartbeat Gatus expects at its interval: base (full and diff), copy and verify. Without it (development, the drill)
# no heartbeat is sent; that is the setting, not a failure. A heartbeat the monitor does not take never fails the
# step: a monitor that hears nothing raises the alert for a missing heartbeat itself.
# Every scheduled step also writes down how it ended under OUTCOME_DIRECTORY, monitor or not: <step> the last outcome,
# <step>.ok the moment of its last success, which due reads and a shop's twes tick alerts on. One step runs at a time,
# so the copy taken before an update never meets a scheduled one in pgBackRest's own lock.
set -euo pipefail

STANZA=twes
DUMP_DIR=/var/lib/twes-backup/dump
FILES_DIR=/files
KEEP=14d
OUTCOME_DIRECTORY=${OUTCOME_DIRECTORY:-/var/lib/twes-backup/outcome}
BACKUP_LOCK=${BACKUP_LOCK:-/tmp/twes-backup.lock}

say() { printf '%s twes-backup %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
pgbr() { gosu postgres pgbackrest --stanza="$STANZA" "$@"; }
# restic reaches the same bucket as pgBackRest under its own prefix; a bucket addressed by path (most S3-compatible
# services) or by host (AWS itself) is said once, in BACKUP_S3_URI_STYLE, for both.
rst() {
  local lookup=dns
  [[ "${BACKUP_S3_URI_STYLE:-host}" == path ]] && lookup=path
  restic -o "s3.bucket-lookup=$lookup" "$@"
}

wait_for_database() {
  local tries=0
  until gosu postgres pg_isready -q -h /var/run/postgresql -U twes -d twes; do
    tries=$((tries + 1))
    ((tries < 60)) || { say "the database did not answer in 60 s"; return 1; }
    sleep 1
  done
}

init() {
  wait_for_database
  # A shop's folder is named by an identity its values carry (scripts/onprem/twes): a drive unplugged leaves an empty
  # folder in its place, and a stanza made there would take the archive onto the computer's own disk. Refused, the
  # archive waits in pg_wal until the drive is back, and every step fails, which twes tick says.
  if [[ -n "${BACKUP_FOLDER_ID:-}" ]]; then
    local found=''
    [[ -f "${BACKUP_FOLDER:-/backup}/twes-in-backups.id" ]] && read -r found < "${BACKUP_FOLDER:-/backup}/twes-in-backups.id"
    [[ "$found" == "$BACKUP_FOLDER_ID" ]] || { say "${BACKUP_FOLDER:-/backup} is not the backups' folder the values name ($BACKUP_FOLDER_ID): plug its drive back in"; return 1; }
  fi
  # A shop's folder (compose.backup-local.yaml) starts empty, or as a host path owned by whoever made it; pgBackRest
  # writes it as the server's own user, archiving included.
  if [[ "${PGBACKREST_REPO1_TYPE:-}" == posix ]]; then
    install -d -o postgres -g postgres -m 0750 "${PGBACKREST_REPO1_PATH:?a folder repository needs its path}"
  fi
  pgbr stanza-create
  # `cat config` reads the repository's own header: absent means never made, any other failure is a real one.
  if ! rst cat config >/dev/null 2>&1; then
    say "restic repository not found, making it"
    rst init
  fi
  pgbr check
  rst cat config >/dev/null
  say "ready: stanza $STANZA and the files repository"
}

base_backup() {
  pgbr --type="$1" backup
  say "$1 backup done"
}

copy() {
  local tag=${1:-nightly}
  wait_for_database
  # Written beside, then moved: a dump cut short by a crash never replaces last night's whole one.
  gosu postgres pg_dump -h /var/run/postgresql -U twes -d twes --format=custom --file="$DUMP_DIR/twes.dump.part"
  gosu postgres mv "$DUMP_DIR/twes.dump.part" "$DUMP_DIR/twes.dump"
  rst backup --tag "$tag" --host twes "$DUMP_DIR" "$FILES_DIR"
  rst forget --host twes --keep-within "$KEEP" --prune
  say "dump and files copied ($tag), kept $KEEP"
}

# The local folder holds both repositories already encrypted; the off-site copy is one more restic repository, in the
# bucket, which a lost machine is restored from by copying the folder back first (docs/RUNBOOK.md, « Restore a lost
# shop machine »).
offsite() {
  if [[ -z "${OFFSITE_REPOSITORY:-}" ]]; then
    say "off-site copy off (compose.backup-offsite.yaml is not in this installation)"
    return 0
  fi
  if ! rst -r "$OFFSITE_REPOSITORY" cat config >/dev/null 2>&1; then
    say "off-site repository not found, making it"
    rst -r "$OFFSITE_REPOSITORY" init
  fi
  rst -r "$OFFSITE_REPOSITORY" backup --tag offsite --host twes /backup
  # Copied every hour, pruned once a day: a prune reads and rewrites the bucket's packs, too much to do hourly.
  if (($(since offsite-prune) >= 20 * 3600)); then
    rst -r "$OFFSITE_REPOSITORY" forget --host twes --keep-within "$KEEP" --prune
    mkdir -p "$OUTCOME_DIRECTORY" && date +%s > "$OUTCOME_DIRECTORY/offsite-prune.ok"
  fi
  say "local folder copied off site, kept $KEEP"
}

# What an update is rolled back to when its own rollback is not enough. pgBackRest makes an incremental backup a full
# one when there is none yet; the label is read from its own account of the stanza, the last backup listed.
before_update() {
  pgbr --type=incr --annotation=reason=before-update backup
  local info label=''
  info=$(pgbr --output=json info)
  while [[ "$info" =~ \"label\":\"([^\"]*)\" ]]; do label=${BASH_REMATCH[1]}; info=${info#*"${BASH_REMATCH[0]}"}; done
  [[ -n "$label" ]] || { say "pgBackRest names no backup after the one just made"; return 1; }
  copy before-update
  say "before-update: $label"
}

verify() {
  pgbr verify
  rst check
  say "both repositories read back whole"
}

# The step's heartbeat, whichever way it ended: sent from the exit trap, so the step runs under `set -e` unchanged and
# a failure is reported with the status it exited on.
heartbeat() {
  local status=$? endpoint=$1 success=true reason=''
  ((status == 0)) || { success=false; reason="$2 exited $status"; }
  # The step's own status is what it exits with: an outcome that cannot be written is said, and due runs the step again.
  if mkdir -p "$OUTCOME_DIRECTORY" && if ((status == 0)); then
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ok" > "$OUTCOME_DIRECTORY/$2" && date +%s > "$OUTCOME_DIRECTORY/$2.ok"
  else
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) failed $reason" > "$OUTCOME_DIRECTORY/$2"
  fi; then :; else say "the outcome of $2 could not be written under $OUTCOME_DIRECTORY"; fi
  if [[ -n "${MONITOR_URL:-}" ]]; then
    curl -fsS --max-time 15 -o /dev/null -X POST -H "Authorization: Bearer ${MONITOR_HEARTBEAT_TOKEN:?set MONITOR_HEARTBEAT_TOKEN with MONITOR_URL}" \
      --data-urlencode "success=$success" --data-urlencode "error=$reason" -G \
      "$MONITOR_URL/api/v1/endpoints/Sauvegardes_$endpoint/external" \
      || say "the monitor did not take the $endpoint heartbeat"
  fi
  exit "$status"
}

# How long ago a step last succeeded, in seconds; never is longer than any period.
since() {
  local t=''
  [[ -f "$OUTCOME_DIRECTORY/$1.ok" ]] && read -r t < "$OUTCOME_DIRECTORY/$1.ok"
  [[ "$t" =~ ^[0-9]+$ ]] || { echo 999999999; return 0; }
  echo $(($(date +%s) - t))
}

# Each step in its own process, as the schedule runs it, so it writes its outcome and takes the lock itself. A failed
# step leaves the others to run: a base backup that fails is no reason to skip the night's copy.
due() {
  # The off-site copy's period: what a lost computer loses (docs/START.md § 16). Fifty minutes, since the schedule runs
  # every half hour and an hour's period read a second early would wait the next half hour.
  local self=${BASH_SOURCE[0]} failed=0 day=$((20 * 3600)) week=$((7 * 86400)) every=${OFFSITE_EVERY:-3000}
  # That the schedule is alive, whatever ran: a shop's twes tick alerts when this goes quiet while the application runs.
  mkdir -p "$OUTCOME_DIRECTORY" && echo "$(date +%s) ran" > "$OUTCOME_DIRECTORY/due"
  if (($(since full) >= week)); then
    bash "$self" full || failed=1
  elif (($(since full) >= day && $(since diff) >= day)); then
    bash "$self" diff || failed=1
  fi
  (($(since copy) < day)) || bash "$self" copy || failed=1
  [[ "$every" =~ ^[0-9]+$ ]] || { say "OFFSITE_EVERY=$every: a number of seconds"; return 1; }
  if [[ -n "${OFFSITE_REPOSITORY:-}" ]] && (($(since offsite) >= every)); then bash "$self" offsite || failed=1; fi
  (($(since verify) < week)) || bash "$self" verify || failed=1
  ((failed == 0)) || { say "due: a step failed, written down under $OUTCOME_DIRECTORY"; return 1; }
}

hold() { exec 9> "$BACKUP_LOCK"; flock 9; }

main() {
  case "${1:-}" in
    run)
      local schedule
      case "${BACKUP_SCHEDULE:-nightly}" in
        nightly) schedule=/etc/twes-backup/crontab ;;
        due) schedule=/etc/twes-backup/crontab.due ;;
        *) echo "BACKUP_SCHEDULE=$BACKUP_SCHEDULE: nightly or due, nothing else" >&2; exit 1 ;;
      esac
      # Under the steps' lock, as a step started while the service starts (a drill's, an update's) would otherwise find
      # restic's repository locked by this one; in a subshell, so the schedule does not inherit the lock held.
      (hold; init)
      exec supercronic -passthrough-logs "$schedule" ;;
    init) hold; init ;;
    # Each name is the step's line on the public status page (infra/monitor/gatus.yaml), unaccented: Gatus takes no
    # heartbeat for a name with an accent.
    full|diff) hold; trap "heartbeat Base $1" EXIT; base_backup "$1" ;;
    copy) hold; trap 'heartbeat Copie copy' EXIT; copy ;;
    verify) hold; trap 'heartbeat Relecture verify' EXIT; verify ;;
    # Off, the step never ran: a monitor that never expects it hears nothing.
    offsite) hold; [[ -z "${OFFSITE_REPOSITORY:-}" ]] || trap 'heartbeat Hors_site offsite' EXIT; offsite ;;
    before-update) hold; before_update ;;
    due) due ;;
    # Which compose secrets this container read, by the variable each became: their values are never said.
    secrets)
      local path variable
      for path in "${TWES_SECRETS_DIRECTORY:-/run/secrets}"/*; do
        [[ -f "$path" ]] || continue
        variable=$(basename "$path" | tr 'a-z' 'A-Z')
        if [[ -n "${!variable:-}" ]]; then echo "secrets read: $variable"; else echo "secret not read: $variable"; fi
      done ;;
    *) echo "usage: twes-backup run|init|full|diff|copy|verify|offsite|before-update|due|secrets" >&2; exit 64 ;;
  esac
}

# Sourced by its test (scripts/tests/backup-heartbeat.test.sh), it only defines its functions. Started by
# `docker compose exec`, which skips the entrypoint, it first reads the compose secrets (infra/postgres/twes-secrets).
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  [[ -n "${TWES_SECRETS_READ:-}" || ! -d "${TWES_SECRETS_DIRECTORY:-/run/secrets}" ]] || exec twes-secrets "$0" "$@"
  main "$@"
fi
