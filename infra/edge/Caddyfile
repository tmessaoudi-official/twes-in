#
# The deployment's edge (compose.deploy.yaml; docs/START.md § 14): every request reaches the instance here, over TLS, and
# goes on to the web container, whose nginx serves the app and passes /api and the realtime socket on. Caddy obtains and
# renews the certificate itself, answers plain HTTP with a redirect to HTTPS, and replaces any X-Forwarded-* a client
# sends with what it saw, which nginx and the API then trust as a private address's (api framework.yaml trusted_proxies).
{
	admin off
	# A link's token is a password while it lives (64 hexadecimal characters in the path, the query, or the Referer a
	# page under it sends), and the error line of a failed upstream writes the whole request: every log line here has
	# each run of 32 or more written [token], as the web tier's access log does. Caddy leaves Cookie and Authorization
	# out by itself; X-Sentry-Auth carries the error tracker's key. The same block in every Caddy of the tree
	# (infra/edge/tests/token-free-logs.test.sh).
	log {
		format filter {
			request>uri regexp [0-9A-Fa-f]{32,} [token]
			request>headers>Referer regexp [0-9A-Fa-f]{32,} [token]
			request>headers>X-Sentry-Auth regexp [0-9A-Fa-f]{32,} [token]
		}
	}
}

{$TWES_HOST} {
	# An e-mail address: certificates from a public authority, which writes to it before one expires. `internal`: a
	# certificate from Caddy's own authority, for a check that no public authority can reach (scripts/deploy/deploy-check.sh).
	tls {$EDGE_TLS}
	# A year, for this host alone: another name of the domain (mail, a status page) keeps its own choice, and the domain is
	# not preloaded into browsers.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:80
}
