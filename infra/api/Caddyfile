# ==============================================================================================================
# FrankenPHP / Caddy configuration.
#
# THIS IS NOT A SECOND SERVER. FrankenPHP is a Caddy build with PHP embedded, so this is its own configuration
# file, not the config of a reverse proxy in front of it. One process serves the API, the Angular admin and the
# Flutter web client — which is also what keeps every client on the SAME ORIGIN as the API. That matters: the
# Flutter web build already carries same-origin controls (`mobile/web/`), and putting the API on another origin
# would undo them and force CORS, which is a security surface added for no benefit.
# ==============================================================================================================

{
	# THE DISTRIBUTION'S EXTENSION SEAMS. `CADDY_GLOBAL_OPTIONS`, `CADDY_EXTRA_CONFIG`,
	# `CADDY_SERVER_EXTRA_DIRECTIVES` and `FRANKENPHP_CONFIG` are the variable names FrankenPHP's own image and the
	# API Platform distribution use, so an operator who knows either already knows how to extend this file without
	# rebuilding the image. They were absent until 2026-08-02, which meant any addition — a Mercure hub, an extra
	# listener, a metrics endpoint — required editing this file and rebuilding.
	{$CADDY_GLOBAL_OPTIONS}

	# Caddy's own admin API is OFF. It can rewrite the running configuration over HTTP, so in a container it is a
	# remote-code-execution surface reachable by anything that gets a foothold on the network. Nothing here needs
	# runtime reconfiguration; a config change is a deploy.
	admin off

	# STRUCTURED LOGS to stdout, which is where a container's logs belong — the orchestrator collects them and
	# nothing writes to a file that would fill a layer. JSON because a human greps it once and a log pipeline
	# parses it forever.
	log {
		output stdout
		format json
		level INFO
	}

	frankenphp {
		# WORKER MODE IS DELIBERATELY NOT ENABLED YET, and this is the honest reason rather than an oversight.
		#
		# Worker mode keeps the Symfony kernel resident between requests, which needs `runtime/frankenphp-symfony`
		# to run the request loop. That package's newest release (1.0.0) declares
		# `symfony/http-kernel: ^5.4 || ^6.0 || ^7.0` and this project is on Symfony 8.1, so Composer refuses it.
		#
		# There is a second reason to wait. A resident kernel REUSES database connections across requests,
		# and a tenant left bound on a connection is a cross-tenant read for whoever gets it next — the precise
		# failure `PostgresRowLevelSecurityIsolation` was built against, with `assertNoTenantPinnedOnTheConnection()`
		# and `discardSessionState()` for it. Those controls exist and are tested, but nothing has yet proven them
		# under a real resident worker. Turning worker mode on before that proof exists would be trading a
		# reportable data breach for a latency improvement.
		#
		# When both are resolved, this becomes:
		#     worker {
		#         file /app/public/index.php
		#         num 4
		#     }
		# **AND A THIRD PRECONDITION, now the binding one: the client portal (Wave 10) must have its own
		# `random_bytes(32)` token first.** `UuidV7` seeds its generator state once per PROCESS and a worker
		# process serves many requests, so a seed recoverable from about two dozen observed identifiers stops
		# being confined to one tenant -- a certification round computed a later identifier exactly, across two
		# generator instances. See CLAUDE.md Gotchas 2026-08-05.
		#
		# THIS IS NO LONGER A MATTER OF DISCIPLINE. `scripts/gates/worker-mode-blocked.sh` reads THIS FILE and
		# fails on an uncommented `worker` directive, on an `import`, and on any `APP_RUNTIME` line that is not
		# one of three approved literals -- in EVERY tracked file, not a named list of them, because a list of
		# locations was defeated by `api/.env.prod` and `infra/api/Dockerfile.dev`. Uncommenting the block below
		# turns the gate red. `scripts/gates/compose-config.sh` covers the RENDERED compose environment, which is
		# the half no text sweep can see. Delete BOTH in Wave 10 when the token lands, and not before.
		#
		# (This comment credited `compose-config.sh` with reading this file for two commits, and it never did:
		# `grep -n Caddyfile scripts/gates/compose-config.sh` matched prose only. Corrected in place rather than
		# annotated below, per CLAUDE.md Gotchas 2026-07-29.)
		#
		# `infra/README.md` records the preconditions as owed.
		#
		# `FRANKENPHP_CONFIG` is the seam by which that is switched on WITHOUT editing this file: setting it to
		# `worker /app/public/index.php 4` is the documented spelling. The gate requires it EMPTY -- not merely
		# free of the word `worker` -- because a YAML block scalar can carry the directive on lines the key never
		# appears on. The seam NAME stays: these four are FrankenPHP's own image's variables, and inventing our
		# own spelling of a conventional thing is its own defect. So the block above stays the honest record of
		# why, and the seam stays available the moment the gate is deleted.
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

# The site address comes from the environment so that one image serves a developer's `localhost`, a staging host and
# production without a rebuild. `CLAUDE.md` licensing invariant 9 requires exactly this: hostname is CONFIGURATION,
# never hardcoded, so a public deployment is a config change rather than a code change.
{$SERVER_NAME:localhost} {
	log {
		output stdout
		format json
	}

	# ----------------------------------------------------------------------------------------------------------
	# SECURITY HEADERS, applied to every response including the static bundles.
	# ----------------------------------------------------------------------------------------------------------
	header {
		# Strip the fingerprints. There is no reason to tell an attacker which server and which PHP build this is.
		-Server
		-X-Powered-By

		# HSTS. Two years, subdomains included, preload-eligible. Only meaningful over HTTPS, and harmless
		# otherwise, so it is unconditional rather than duplicated into a second block.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

		# MIME sniffing off: a JSON response must never be executed as script because a browser guessed.
		X-Content-Type-Options "nosniff"

		# Framing denied. There is no legitimate embedding of an invoicing admin in a third-party page, and the
		# consequence of allowing it is clickjacking against actions that move money.
		X-Frame-Options "DENY"

		Referrer-Policy "strict-origin-when-cross-origin"

		# Powerful features nothing here uses. Denying them is free and shrinks what a compromised bundle can do.
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

		# Cross-origin isolation. `same-origin` on the opener policy is what stops a popup retaining a handle on
		# this window, and `require-corp` means no cross-origin subresource loads without opting in — which is the
		# posture the Flutter build already assumes.
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	# ----------------------------------------------------------------------------------------------------------
	# THE API — Symfony, under /api plus the health probes.
	# ----------------------------------------------------------------------------------------------------------
	@php {
		path /api /api/* /health /health/*
	}

	# THE DOCUMENTATION PATHS — the only ones under `/api` that legitimately render as a DOCUMENT rather than as data.
	# Used below to relax the Content-Security-Policy for exactly these and nothing else, so every RESOURCE endpoint
	# (`/api/currencies`, and everything Wave 2 onwards adds) keeps the full lockdown.
	#
	# `/api` is included even though a CLIENT gets JSON-LD from it: content negotiation means one path serves both, and
	# Caddy matches on the path, not on the negotiated response type. The residual exposure is worth naming rather than
	# glossing — a relaxed policy on a JSON response only matters if a browser RENDERS it as a document, which
	# `X-Content-Type-Options: nosniff` below already prevents.
	@apiDocs {
		path /api /api/docs /api/docs.* /api/contexts/*
	}

	# AND ITS COMPLEMENT. The two matchers are DISJOINT on purpose: an unmatched `header` plus a matched one that
	# override the same field is ORDER-DEPENDENT, and Caddy did not resolve it the way the file reads — the strict
	# policy kept winning on the documentation paths. [Verified: `/api` still answered `default-src 'none'` with the
	# relaxed `header @apiDocs` present.] With two disjoint matchers exactly one applies to any request, so the result
	# does not depend on directive order at all.
	@apiData {
		path /api/* /health /health/*
		not path /api /api/docs /api/docs.* /api/contexts/*
	}

	handle @php {
		root * /app/public
		# A strict Content-Security-Policy for API responses: they are DATA and must never be interpreted as a
		# document. `sandbox` neuters any HTML that somehow reaches a browser from this path.
		#
		# RELAXED FOR `@apiDocs` IMMEDIATELY BELOW, and it has to be: `default-src 'none'` plus `sandbox` blocks every
		# stylesheet, image and script AND disables script execution outright, so with it in force the HTML
		# documentation page rendered as a bare unstyled document with broken images and no Swagger UI widget at all —
		# a 200, a correct `<title>`, zero external requests, and nothing usable. [Verified: Chromium reported
		# `Refused to load the stylesheet ... because it violates the following Content Security Policy` for every
		# asset, while `curl` fetched each of them with 200. Nothing short of looking at the page could see it.]
		header {
			# Never cached by a shared cache: every API response is tenant-scoped, and a shared cache that keyed
			# on URL alone would serve one tenant's invoice to another. This is the HTTP-layer echo of the
			# row-level security below it. Applies to the documentation too — it is cheap and harmless there.
			#
			# **`>` IS DEFERRED-SET, and the first version of this block had it on neither field — the `e2e` suite
			# found that on its first run.** Without it, Caddy writes the field before the PHP handler runs and
			# Symfony then sends its OWN value, so the response carried BOTH lines:
			# `Cache-Control: no-store, private` *and* `Cache-Control: no-cache, private`, plus `Vary: Accept,
			# Authorization` *and* `Vary: Accept`. [Verified against the running stack; one line each after the fix.]
			#
			# It was not a hole — RFC 9110 lets a recipient combine repeated field lines, so a conforming cache saw
			# the union and `no-store` won — but the outcome depended on recipient behaviour rather than on this
			# file, which is not a property to rely on. `>` defers the set until the response is written, so the
			# edge is authoritative.
			#
			# **IT IS ON BOTH FIELDS FOR EXPLICITNESS, NOT BECAUSE BOTH NEED IT — measured, because the obvious
			# reading is wrong.** A `header` block containing ANY deferred operation is applied as a whole after the
			# response is written, so `>` on one field silently fixes the other. [Verified against the running stack:
			# with `>` on `Vary` alone, both fields came back single-valued.] Relying on that would make a correct
			# response depend on a neighbouring line — delete the wrong one and the other regresses with nothing
			# saying why. Stating it per field is what makes each one's behaviour readable on its own line.
			#
			# THE ACCEPTED COST, stated because it is a real one: `>Vary` REPLACES whatever the application sent, so
			# an endpoint that later needs to vary on something else — `Accept-Language`, say — must widen this
			# floor rather than declaring it locally. That is a visible diff here instead of a silent divergence
			# between two layers, which is the trade being made.
			>Cache-Control "no-store, private"
			>Vary "Accept, Authorization"
		}

		# THE STRICT POLICY, for every API response that is DATA. Scoped to `@apiData` rather than left unmatched, so
		# that it and the documentation policy below are mutually exclusive.
		header @apiData Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"

		# The documentation page's own policy, replacing the one above for `@apiDocs` only. Everything is `'self'` —
		# no CDN and no third-party origin, which is what makes the whole page self-hosted — and the two
		# `'unsafe-inline'` allowances are what Swagger UI genuinely needs: API Platform's template carries an inline
		# bootstrap script, and the widget injects styles at runtime.
		#
		# `frame-ancestors 'none'` is KEPT, so the page still cannot be embedded. `sandbox` is dropped, because it
		# disables script execution unconditionally and the page is a script.
		header @apiDocs Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		php_server {
			# The front controller is the ONLY entry point. Without this, a request for a `.php` file that happens
			# to exist anywhere under the root would execute it.
			try_files {path} /index.php
			# `index.php` is not resolved as a directory index, so `/api/` cannot be served by path traversal.
			resolve_root_symlink
		}
	}

	# ----------------------------------------------------------------------------------------------------------
	# THE API'S OWN DOCUMENTATION ASSETS — API Platform's Swagger UI css, js and fonts, published into
	# `public/bundles/apiplatform/` by `assets:install`.
	#
	# THIS BLOCK IS WHY THE DOCUMENTATION PAGE IS STYLED AT ALL. Without it the final `handle` below answers 404 to
	# every asset the page requests. [Verified: `/bundles/apiplatform/swagger-ui/swagger-ui.css` returned 404 and a
	# real Chromium screenshot showed a bare document with broken images.]
	#
	# NARROW ON PURPOSE, and NOT a file server over `public/`. This server executes ONLY the front controller — that
	# property is what stops any `.php` reaching a writable path from being run — so the static exception is scoped to
	# the one generated directory rather than to the document root. Nothing under `bundles/` is ours or executable; it
	# is a copy of a dependency's public assets.
	#
	# `handle`, NOT `handle_path`: these files really do live at `bundles/...` beneath the root, so the prefix must be
	# KEPT. `handle_path` would strip it and look for `/app/public/apiplatform/...`.
	handle /bundles/* {
		root * /app/public
		# Versioned by the dependency rather than content-hashed, so a long immutable max-age would be wrong — a
		# `composer update` changes the bytes at the same URL. A day keeps the page snappy while bounding how long a
		# stale asset can outlive an upgrade.
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# ----------------------------------------------------------------------------------------------------------
	# THE ANGULAR ADMIN — a static bundle, served from the same origin at /admin.
	# ----------------------------------------------------------------------------------------------------------
	handle_path /admin/* {
		root * /srv/admin
		header {
			# Hashed asset filenames are immutable; the entry document is not, or a deploy would never be picked
			# up by a returning browser.
			Cache-Control "public, max-age=31536000, immutable"
		}
		@adminIndex path /index.html /
		header @adminIndex Cache-Control "no-cache"
		# SPA routing: an unknown path is the application's route, not a 404 — but only after a real file lookup,
		# so a missing asset is still honestly a 404 rather than the index document with a 200.
		try_files {path} {path}/ /index.html
		file_server
	}

	# ----------------------------------------------------------------------------------------------------------
	# THE FLUTTER WEB CLIENT — the second admin interface, per CLAUDE.md. Same origin, same process.
	# ----------------------------------------------------------------------------------------------------------
	handle_path /app/* {
		root * /srv/flutter
		header Cache-Control "public, max-age=31536000, immutable"
		@flutterIndex path /index.html /
		header @flutterIndex Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	# Anything else. No directory listing, no fallthrough to PHP, no information about what exists.
	handle {
		respond "Not Found" 404
	}

	# The per-site seam, spliced in last so it can override anything above it.
	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# gzip and zstd. Brotli is deliberately absent: Caddy's built-in `encode` does not ship it, and adding a plugin
	# means a custom FrankenPHP build — a real cost for a marginal gain on already-compressed JSON.
	encode zstd gzip
}
